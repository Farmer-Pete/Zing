<zing job="build" outcome="ok"> <!-- job: Job, one of: classify | planning | planreview | build | perimeter | review | judge | respond | side, the running job; must match; outcome: Outcome, one of: ok | question | error, one of this job's outcomes, or question, or error -->
  <claims> <!-- BuildClaims -->
    <files_changed>
      <path>...</path> <!-- string, optional, zero or more, every changed path, or none for a fix run whose failure is not in the code; the program diffs the tree -->
    </files_changed>
  </claims>
  <extra path="...">...</extra> <!-- ExtraClaim, optional, zero or more, one per changed path the plan does not declare; path: string -->
  <fence path="..." symbol="...">...</fence> <!-- Fence, optional, zero or more, one per deletion this task made; path: string; symbol: string -->
  <report>...</report> <!-- string, what was built, what was decided, markdown -->
  <notes>...</notes> <!-- string, anything the owner must know -->
</zing>
