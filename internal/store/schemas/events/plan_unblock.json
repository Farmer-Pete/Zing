{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "finding_ids": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "minItems": 1
    },
    "guidance": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "plan_version",
    "finding_ids",
    "guidance"
  ]
}
