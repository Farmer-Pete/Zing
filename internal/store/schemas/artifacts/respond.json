{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "threads": {
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "fix",
              "reply",
              "nit",
              "addressed"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "action",
          "text"
        ]
      },
      "type": "array",
      "maxItems": 1000,
      "minItems": 1
    },
    "batch": {
      "type": "integer",
      "minimum": 1
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "seen": {
      "items": {
        "properties": {
          "tid": {
            "type": "string",
            "pattern": "^t[0-9a-f]{16}$"
          },
          "last_comment": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tid",
          "last_comment"
        ]
      },
      "type": "array",
      "maxItems": 1000,
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "threads",
    "batch",
    "sha",
    "seen"
  ]
}
