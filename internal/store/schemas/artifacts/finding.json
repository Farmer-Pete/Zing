{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "lens": {
      "type": "string",
      "enum": [
        "problem",
        "simplification",
        "correctness",
        "security",
        "fidelity",
        "tests",
        "quality",
        "observability"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "blocker",
        "major",
        "minor",
        "nit"
      ]
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "fix": {
      "type": "string",
      "minLength": 1
    },
    "plan_ref": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "accept",
        "drop",
        "discuss"
      ]
    },
    "held": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "pattern": "^r[1-9][0-9]*[fh][1-9][0-9]*$"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "lenses": {
      "items": {
        "type": "string",
        "enum": [
          "problem",
          "simplification",
          "correctness",
          "security",
          "fidelity",
          "tests",
          "quality",
          "observability"
        ]
      },
      "type": "array",
      "maxItems": 7,
      "minItems": 1
    },
    "supersedes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "lens",
    "severity",
    "location",
    "text",
    "fix",
    "id",
    "round",
    "sha",
    "lenses"
  ]
}
