{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "path": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "modify",
        "delete"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "trust_root": {
      "type": "boolean"
    },
    "style_guide": {
      "type": "boolean"
    },
    "task_n": {
      "type": "integer",
      "maximum": 12,
      "minimum": 0
    },
    "description": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "accept",
        "reject"
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "path",
    "action",
    "reason",
    "trust_root",
    "style_guide",
    "task_n"
  ]
}
