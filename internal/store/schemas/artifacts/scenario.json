{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^s[0-9]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "behavior",
        "negative",
        "performance"
      ]
    },
    "check_cmd": {
      "type": "string"
    },
    "given": {
      "type": "string",
      "minLength": 1
    },
    "when": {
      "type": "string",
      "minLength": 1
    },
    "then": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "kind",
    "check_cmd",
    "given",
    "when",
    "then"
  ]
}
