{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "task_n": {
      "type": "integer"
    },
    "files_changed": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "minItems": 1
    },
    "test_exit": {
      "type": "integer"
    },
    "lint_exit": {
      "type": "integer"
    },
    "report": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "task_n",
    "files_changed",
    "test_exit",
    "lint_exit",
    "report"
  ]
}
