{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^s[0-9]+$"
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "behavior",
        "negative",
        "performance",
        "host"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "check_exit": {
      "type": "integer",
      "maximum": 255,
      "minimum": -1
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "scenario_id",
    "result",
    "evidence",
    "kind",
    "round",
    "sha"
  ]
}
