{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^s[0-9]+$"
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "scenario_id",
    "result",
    "evidence"
  ]
}
