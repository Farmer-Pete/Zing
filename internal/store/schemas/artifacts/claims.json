{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "code",
          "env"
        ]
      },
      "verdict": {
        "type": "string",
        "enum": [
          "true",
          "false",
          "unchecked"
        ]
      },
      "evidence": {
        "type": "string"
      },
      "text": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
      "kind",
      "verdict",
      "evidence",
      "text"
    ]
  },
  "type": "array",
  "minItems": 1
}
