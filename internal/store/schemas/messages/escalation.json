{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "resumes_exhausted",
        "loops_exhausted",
        "wall_clock",
        "usage_hold",
        "plan_gap",
        "cannot_run",
        "environment",
        "other",
        "split_unsupported",
        "nothing_to_do_with_true_claims",
        "runtime_exec_failed",
        "response_invalid",
        "seal_failed",
        "post_run_failed",
        "sandbox_unavailable",
        "replan_unsupported"
      ]
    },
    "what": {
      "type": "string",
      "minLength": 1
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "tried": {
      "type": "string"
    },
    "options": {
      "items": {
        "type": "string",
        "enum": [
          "retry",
          "planning",
          "abandon"
        ]
      },
      "type": "array"
    },
    "session_id": {
      "type": "integer"
    },
    "origin": {
      "type": "string",
      "enum": [
        "classify",
        "planning_first",
        "planning_resume",
        "planreview",
        "gate_approve",
        "seal",
        "cap_resumes",
        "cap_loops",
        "cap_budget",
        "split",
        "nothing_to_do_claims",
        "build",
        "perimeter",
        "fix"
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "code",
    "what",
    "why",
    "tried",
    "options",
    "origin"
  ]
}
