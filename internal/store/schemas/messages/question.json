{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^Q[0-9]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "question",
        "gate",
        "split",
        "perimeter",
        "review",
        "merge"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "answered",
        "resolved"
      ]
    },
    "recommended": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "items": {
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z]$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "text"
        ]
      },
      "type": "array",
      "maxItems": 4
    },
    "items": {
      "items": {
        "properties": {
          "ref": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "accept",
              "reject",
              "drop",
              "discuss"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ref",
          "text"
        ]
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "key",
    "kind",
    "state",
    "recommended",
    "options"
  ]
}
