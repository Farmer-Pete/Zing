package templates

import (
	"fmt"

	"zing/internal/store"
)

// TicketsFragment renders the #tickets element alone, the payload GET
// /updates patches on connect and on every bus signal (design section 6.9,
// ported from Package 3's tickets.gohtml).
templ TicketsFragment(tickets []store.Ticket) {
	<aside id="tickets">
		<h2>Tickets</h2>
		if len(tickets) == 0 {
			<p class="empty">No tickets yet.</p>
		} else {
			for _, t := range tickets {
				@ticketRow(t)
			}
		}
	</aside>
}

templ ticketRow(t store.Ticket) {
	<button class="ticket" data-on:click={ fmt.Sprintf("$open = %d", t.ID) }>
		<span class="title">{ t.Title }</span>
		<span class={ "badge state-" + t.State }>{ t.State }</span>
	</button>
}
