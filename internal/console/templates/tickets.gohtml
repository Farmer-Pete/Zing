{{define "ticketsFragment"}}<aside id="tickets">
<h2>Tickets</h2>
{{range .}}<button class="ticket" data-on:click="$open = {{.ID}}">
<span class="title">{{.Title}}</span>
<span class="badge state-{{.State}}">{{.State}}</span>
</button>
{{else}}<p class="empty">No tickets yet.</p>
{{end}}</aside>
{{end}}
