package templates

import "strconv"

// Alerts renders the #alerts region (design section 6a, D8): every
// slog.LevelWarn-and-above log line the console's log Handler currently
// holds, newest first, live -- so a best-effort warning (the pickup
// comment's own slog.Warn, and any other) reaches the operator instead of
// only a log file. Like #nav, #main, and #rail, this is always patched,
// even when lines is empty (design section 6.3: every region is patched on
// every frame); an empty alerts strip simply renders no rows, rather than a
// placeholder message, since there is nothing an operator needs to read
// here when there are no warnings.
//
// A line never renders a body: LogEntry (log.go) holds only Time, Level,
// Message, and the resolved ids, never an attribute, and every call site
// that would log a body-shaped value uses FencedAttr (length plus hash)
// instead of the message. This view is exactly as safe as that existing
// discipline; see AlertLine's own doc comment.
templ Alerts(lines []AlertLine) {
	<div id="alerts" class="alerts">
		if len(lines) > 0 {
			<ul class="alert-lines">
				for _, line := range lines {
					<li class={ "alert-line alert-level-" + line.Level }>
						<span class="alert-time">{ line.Time }</span>
						<span class="alert-level">{ line.Level }</span>
						<span class="alert-message">{ line.Message }</span>
						if line.HasTicket {
							<span class="alert-ticket">ticket { strconv.FormatInt(line.TicketID, 10) }</span>
						}
					</li>
				}
			</ul>
		}
	</div>
}
