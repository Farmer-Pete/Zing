package templates

import (
	"fmt"

	"zing/internal/store"
)

// statePill renders a ticket's compact state indicator: its bare state, or
// "state · waiting_on" when blocking (design section 6.5). Reused across
// Inbox, Recent, and Project -- three call sites, this file's one
// abstraction (repo style: "three repetitions before an abstraction").
templ statePill(t store.Ticket) {
	if t.WaitingOn != nil {
		<span class="pill pill-waiting">{ t.State } · { *t.WaitingOn }</span>
	} else {
		<span class="pill">{ t.State }</span>
	}
}

// ticketRow renders one ticket line: ref, title, and its state pill, as a
// link that opens the ticket's thread through the same zing-nav dispatch
// #nav's threadLink uses. Recent and Project share it (design section 6.5,
// Q3: both are "real but thin" and "reuse the inbox row renderer"); Feed
// renders messages, not tickets, so it does not use this.
templ ticketRow(t store.Ticket) {
	<a href="#" class="ticket-row" data-focus-id={ fmt.Sprintf("ticket:%d", t.ID) } data-on:click__prevent={ zingNavExpr("thread", t.ID, 0) }>
		<span class="ref">{ displayRef(t.TrackerRef) }</span>
		<span class="title">{ t.Title }</span>
		@statePill(t)
	</a>
}

// displayRef strips a tracker_ref's -abandoned-K suffix (#65,
// store.SplitAttemptRef): every ref the console renders is the issue's own
// ref, never the renamed one a restart or pickup gave an abandoned ticket.
func displayRef(ref string) string {
	base, _ := store.SplitAttemptRef(ref)
	return base
}
