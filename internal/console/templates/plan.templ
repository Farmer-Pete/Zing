package templates

import (
	"strconv"

	"zing/internal/response"
)

// PlanView renders a stored plan in full (design section 6.9's
// field-to-render map, exhaustive): the four parts (Overview, Design,
// Delivery, Review) as <h2>, their children as <h3>, and every field --
// prose already pre-rendered onto p by internal/console/plan.go, every
// list, table, and "none" line built straight from what is stored. It
// never recomputes files, tasks, or fences into rows of its own.
templ PlanView(p RenderedPlan) {
	<article class="plan">
		<h2>Overview</h2>
		<h3>Objective</h3>
		<p>{ p.Overview.Objective }</p>
		<h3>Context</h3>
		@p.Overview.ContextHTML
		<h3>Problem</h3>
		@planProblem(p.Overview.Problem)
		<h3>Goals</h3>
		@stringList(p.Overview.Goals)
		<h3>Non-goals</h3>
		@stringList(p.Overview.NonGoals)
		<h2>Design</h2>
		<h3>Demo</h3>
		@cmdBlock(p.Design.Demo.Cmd, p.Design.Demo.Text)
		<h3>Shape</h3>
		@p.Design.ShapeHTML
		<h3>Changes</h3>
		@changeBlocks(p.Design.Changes)
		<h3>Types</h3>
		@typesSection(p.Design.Types)
		<h3>Migrations</h3>
		@migrationsSection(p.Design.Migrations)
		<h2>Delivery</h2>
		<h3>Files</h3>
		@filesTable(p.TicketID, p.Editable, p.Claimed, p.Delivery.Files)
		@decidedFilesSection(p.Delivery.DecidedFiles)
		<h3>Deletions</h3>
		@deletionsSection(p.Delivery.Deletions)
		<h3>Tests</h3>
		@testsTable(p.Delivery.Tests)
		<h3>Tasks</h3>
		@tasksTable(p.TicketID, p.Editable, p.Claimed, p.Delivery.Tasks)
		if len(p.Delivery.OwnerSmoke) > 0 {
			<h3>Owner smoke</h3>
			@stringList(p.Delivery.OwnerSmoke)
		}
		<h2>Review</h2>
		<h3>Trust root</h3>
		<p>{ p.Review.TrustRoot }</p>
		<h3>Alternatives</h3>
		@stringList(p.Review.Alternatives)
		<h3>Risks</h3>
		@stringList(p.Review.Risks)
	</article>
}

// stringList renders Goals, Non-goals, Alternatives, and Risks (design
// section 6.9): every one of the plan's plain string lists.
templ stringList(items []string) {
	<ul>
		for _, s := range items {
			<li>{ s }</li>
		}
	</ul>
}

// cmdBlock renders a Demo or a bug Loop as its cmd plus its text (design
// section 6.9: "Demo (the cmd and its text)"; "the Loop as a cmd plus its
// text"), the two fields that share this exact shape.
templ cmdBlock(cmd, text string) {
	<p><code class="cmd">{ cmd }</code></p>
	<p>{ text }</p>
}

// planProblem renders Overview.Problem (design section 6.9): its markdown
// text, then, for a bug, the Loop, the Repro, and the ranked Hypotheses
// table. Loop is nil for a feature, so this renders nothing beyond the
// prose in that case.
templ planProblem(p RenderedProblem) {
	@p.TextHTML
	if p.Loop != nil {
		<h4>Loop</h4>
		@cmdBlock(p.Loop.Cmd, p.Loop.Text)
	}
	if p.Repro != "" {
		<h4>Repro</h4>
		<pre>{ p.Repro }</pre>
	}
	if len(p.Hypotheses) > 0 {
		<h4>Hypotheses</h4>
		<table class="hypotheses">
			<thead>
				<tr>
					<th>Rank</th>
					<th>Cause</th>
					<th>Prediction</th>
				</tr>
			</thead>
			<tbody>
				for _, h := range p.Hypotheses {
					<tr>
						<td>{ strconv.Itoa(h.Rank) }</td>
						<td>{ h.Cause }</td>
						<td>{ h.Prediction }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// changeBlocks renders Design.Changes (design section 6.9) as one block per
// change rather than a row of an 8-column table (bug fix): Before and
// After hold whole source files, so a table row grew hundreds of pixels
// tall and mostly empty in the ~800px thread column. Each change gets a
// heading line (path, symbol, kind), a short definition list for Callers,
// Callees, and Simple call -- each omitted when empty -- then Before
// (omitted when "none" or empty, the no-code-today case) and After as
// their own code blocks.
templ changeBlocks(changes []response.Change) {
	for _, c := range changes {
		<div class="change-block">
			<h4>{ c.Path } { c.Symbol } ({ string(c.Kind) })</h4>
			<dl class="run-fields">
				if c.Callers != "" {
					<dt>Callers</dt>
					<dd>{ c.Callers }</dd>
				}
				if c.Callees != "" {
					<dt>Callees</dt>
					<dd>{ c.Callees }</dd>
				}
				if c.SimpleCall != "" {
					<dt>Simple call</dt>
					<dd>{ c.SimpleCall }</dd>
				}
			</dl>
			if c.Before != "" && c.Before != "none" {
				<p><strong>Before</strong></p>
				<pre class="change-code">{ c.Before }</pre>
			}
			<p><strong>After</strong></p>
			<pre class="change-code">{ c.After }</pre>
		</div>
	}
}

// typesSection renders Design.Types (design section 6.9): a table per type
// of name, file, kind, a fields table (type, required, default,
// constraints), and, when the type has any, a transitions sub-table of
// from, to, when.
templ typesSection(types []response.TypeDef) {
	for _, t := range types {
		<div class="type-def">
			<table class="type-meta">
				<thead>
					<tr>
						<th>Name</th>
						<th>File</th>
						<th>Kind</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>{ t.Name }</td>
						<td>{ t.File }</td>
						<td>{ string(t.Kind) }</td>
					</tr>
				</tbody>
			</table>
			<table class="fields">
				<caption>Fields</caption>
				<thead>
					<tr>
						<th>Name</th>
						<th>Type</th>
						<th>Required</th>
						<th>Default</th>
						<th>Constraints</th>
					</tr>
				</thead>
				<tbody>
					for _, f := range t.Fields {
						<tr>
							<td>{ f.Name }</td>
							<td>{ f.Type }</td>
							<td>{ strconv.FormatBool(f.Required) }</td>
							<td>{ f.Default }</td>
							<td>{ f.Constraints }</td>
						</tr>
					}
				</tbody>
			</table>
			if len(t.Transitions) > 0 {
				<table class="transitions">
					<caption>Transitions</caption>
					<thead>
						<tr>
							<th>From</th>
							<th>To</th>
							<th>When</th>
						</tr>
					</thead>
					<tbody>
						for _, tr := range t.Transitions {
							<tr>
								<td>{ tr.From }</td>
								<td>{ tr.To }</td>
								<td>{ tr.When }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	}
}

// migrationsSection renders Design.Migrations (design section 6.9): each
// migration as file, schema, backfill, locks, compat, rollback, or, when
// Migrations.None, a "none" line rather than an empty table.
templ migrationsSection(m response.Migrations) {
	if m.None {
		<p class="none">No migrations.</p>
	} else {
		for _, mig := range m.Items {
			<div class="migration">
				<h4>{ mig.File }</h4>
				<p><strong>Schema</strong></p>
				<pre>{ mig.Schema }</pre>
				<p><strong>Backfill</strong></p>
				<pre>{ mig.Backfill }</pre>
				<p><strong>Locks</strong></p>
				<pre>{ mig.Locks }</pre>
				<p><strong>Compat</strong></p>
				<pre>{ mig.Compat }</pre>
				<p><strong>Rollback</strong></p>
				<pre>{ mig.Rollback }</pre>
			</div>
		}
	}
}

// filesTable renders Delivery.Files (design section 6.9): a table of path,
// action, tasks, reason. Delivery.Files carries no "none" case (jsonschema
// minItems=1, internal/response/types.go): the perimeter is never empty.
// editable is RenderedPlan.Editable (#41, extended by the file-grant
// change): only then does each row gain a last cell holding ticketID's own
// owner-edit box (ownerEditFileForm) for that file.
templ filesTable(ticketID int64, editable, claimed bool, files []response.FileChange) {
	<table class="files">
		<thead>
			<tr>
				<th>Path</th>
				<th>Action</th>
				<th>Tasks</th>
				<th>Reason</th>
				if editable {
					<th></th>
				}
			</tr>
		</thead>
		<tbody>
			for _, f := range files {
				<tr>
					<td>{ f.Path }</td>
					<td>{ string(f.Action) }</td>
					<td>{ f.Task }</td>
					<td>{ f.Reason }</td>
					if editable {
						<td>
							@ownerEditFileForm(ticketID, f, claimed)
						</td>
					}
				</tr>
			}
		</tbody>
	</table>
}

// ownerEditFileForm is one delivery file's owner-edit box (#51): a
// <details class="owner-edit"> the owner opens to rewrite which tasks may
// change f.Path, posted by console.js's ownerEditSubmit to POST
// /tickets/{id}/edit, the same box ownerEditTaskForm already uses for a
// plan task.
templ ownerEditFileForm(ticketID int64, f response.FileChange, claimed bool) {
	<details class="owner-edit" data-preserve-attr="open" data-ticket={ strconv.FormatInt(ticketID, 10) } data-target="plan_file" data-ref={ f.Path }>
		<summary>Edit tasks</summary>
		@ownerEditClaimNote(claimed)
		<label>Tasks</label>
		<input type="text" data-field="tasks" value={ f.Task } disabled?={ claimed }/>
		<button type="button" class="owner-edit-save" disabled?={ claimed }>Save</button>
		<span class="owner-edit-error"></span>
	</details>
}

// decidedFilesSection renders Delivery.DecidedFiles (design section 9.2): a
// "Decided during build" sub-list of path, decision, task number, marker,
// builder reason, and perimeter description, fed by the newest FileEvents
// row per path that carries an owner decision. It renders nothing when
// DecidedFiles is empty (no perimeter decision made yet).
templ decidedFilesSection(files []response.FileArtifact) {
	if len(files) > 0 {
		<h4>Decided during build</h4>
		<table class="decided-files">
			<thead>
				<tr>
					<th>Path</th>
					<th>Decision</th>
					<th>Task</th>
					<th>Marker</th>
					<th>Builder reason</th>
					<th>Description</th>
				</tr>
			</thead>
			<tbody>
				for _, f := range files {
					<tr>
						<td>{ f.Path }</td>
						<td>{ string(*f.Decision) }</td>
						<td>{ strconv.Itoa(f.TaskN) }</td>
						<td>{ decidedMarker(f) }</td>
						<td>{ f.Reason }</td>
						<td>{ f.Description }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// decidedMarker renders one decided file's marker (design section 4.1,
// 6.5, 9.2): "trust root" or "style guide" when set, empty otherwise.
func decidedMarker(f response.FileArtifact) string {
	switch {
	case f.TrustRoot:
		return "trust root"
	case f.StyleGuide:
		return "style guide"
	default:
		return ""
	}
}

// deletionsSection renders Delivery.Deletions (design section 6.9): a table
// of path, symbol, existed-because, or, when Deletions.None, a "none" line.
templ deletionsSection(d response.Deletions) {
	if d.None {
		<p class="none">Nothing deleted.</p>
	} else {
		<table class="deletions">
			<thead>
				<tr>
					<th>Path</th>
					<th>Symbol</th>
					<th>Existed because</th>
				</tr>
			</thead>
			<tbody>
				for _, f := range d.Items {
					<tr>
						<td>{ f.Path }</td>
						<td>{ f.Symbol }</td>
						<td>{ f.ExistedBecause }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// testsTable renders Delivery.Tests (design section 6.9): a table of name,
// seam, kind, mocks, asserts.
templ testsTable(tests []response.TestCase) {
	<table class="tests">
		<thead>
			<tr>
				<th>Name</th>
				<th>Seam</th>
				<th>Kind</th>
				<th>Mocks</th>
				<th>Asserts</th>
			</tr>
		</thead>
		<tbody>
			for _, tc := range tests {
				<tr>
					<td>{ tc.Name }</td>
					<td>{ tc.Seam }</td>
					<td>{ string(tc.Kind) }</td>
					<td>{ tc.Mocks }</td>
					<td>{ tc.Asserts }</td>
				</tr>
			}
		</tbody>
	</table>
}

// tasksTable renders Delivery.Tasks (design section 6.9): a table of n,
// demo, test, text, with each task's markdown Text pre-rendered onto it.
// editable is RenderedPlan.Editable (#41): only then does each row gain a
// last cell holding ticketID's own owner-edit box (ownerEditTaskForm) for
// that task, so a plan with no sealed scenario -- or the artifacts rail's
// own read-only copy, ticketID 0 -- renders no edit controls at all.
templ tasksTable(ticketID int64, editable, claimed bool, tasks []RenderedTask) {
	<table class="tasks">
		<thead>
			<tr>
				<th>N</th>
				<th>Demo</th>
				<th>Test</th>
				<th>Text</th>
				if editable {
					<th></th>
				}
			</tr>
		</thead>
		<tbody>
			for _, t := range tasks {
				<tr>
					<td>{ strconv.Itoa(t.N) }</td>
					<td>{ strconv.FormatBool(t.Demo) }</td>
					<td>{ t.Test }</td>
					<td>
						@t.TextHTML
					</td>
					if editable {
						<td>
							@ownerEditTaskForm(ticketID, t, claimed)
						</td>
					}
				</tr>
			}
		</tbody>
	</table>
}

// ownerEditTaskForm is one plan task's owner-edit box (#41): a <details
// class="owner-edit"> the owner opens to rewrite text, test, or demo, or
// drop the task, posted by console.js's ownerEditSubmit to POST
// /tickets/{id}/edit. t.Text, not t.TextHTML, prefills the textarea -- the
// owner edits the raw markdown, not its rendered HTML.
// data-preserve-attr="open" keeps it open across a /stream patch while the
// owner is editing, matching questionGroup's own use of the attribute. The
// textarea's content opens with a "\n" (bug fix): the HTML parser drops
// exactly one leading newline right after a textarea's opening tag, so
// without it a stored text that itself starts with a newline would render
// one character short; the prefix makes the parser's drop a no-op either way.
templ ownerEditTaskForm(ticketID int64, t RenderedTask, claimed bool) {
	<details class="owner-edit" data-preserve-attr="open" data-ticket={ strconv.FormatInt(ticketID, 10) } data-target="plan_task" data-ref={ strconv.Itoa(t.N) }>
		<summary>Edit</summary>
		@ownerEditClaimNote(claimed)
		<label>Text</label>
		<textarea data-field="text" disabled?={ claimed }>{ "\n" + t.Text }</textarea>
		<label>Test</label>
		<input type="text" data-field="test" value={ t.Test } disabled?={ claimed }/>
		<label>Demo</label>
		<input type="checkbox" data-field="demo" checked?={ t.Demo } disabled?={ claimed }/>
		<button type="button" class="owner-edit-save" disabled?={ claimed }>Save</button>
		<button type="button" class="owner-edit-drop" disabled?={ claimed }>Drop</button>
		<span class="owner-edit-error"></span>
	</details>
}
