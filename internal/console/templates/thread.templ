package templates

import (
	"fmt"
	"regexp"
	"strconv"
	"strings"

	"zing/internal/response"
	"zing/internal/store"
)

// ownerEditClaimNote is an owner-edit box's claim note (#75 Q2): the
// store's own refusal sentence, shown only while a run holds the ticket's
// claim, when the box's controls render disabled.
templ ownerEditClaimNote(claimed bool) {
	if claimed {
		<p class="owner-edit-claim-note">{ store.OwnerEditClaimedReason }</p>
	}
}

// Thread renders the #main region for view=thread (design section 6.6):
// the ticket's messages in id order, read only except for the question
// groups, which dispatch on QuestionPayload.Kind into interactive controls
// (Task 6). ticket is nil when open is 0 or names no ticket. wait is the
// current round's answered-vs-total count (bug fix: console.buildWaitProgress);
// its own Total == 0 means the ticket is not currently question-blocked, so
// waitProgressBanner renders nothing. banner is console.buildAgentStatus's
// own text (design section 22.7): non-empty, it replaces waitProgressBanner
// outright, since a ticket carrying even one planning question has its own
// conversation-aware banner instead of the round-based one; empty renders
// no banner at all (every planning thread settled), still in place of
// waitProgressBanner -- buildAgentStatus is call only when the ticket
// carries a planning question at all, console.threadComponent's own guard.
// actions is console.ticketActions' own build of the owner's action bar
// (#65), rendered right after the title by ticketActionBar.
// sealed is threadComponent's post-gate "Sealed plan and scenarios" section
// (#75): nil when console.showSealedSection reports the ticket does not
// get one.
templ Thread(ticket *store.Ticket, rows []ThreadRow, wait WaitProgress, banner string, actions TicketActions, sealed *SealedSection) {
	<main id="main" class="view-thread">
		if ticket != nil {
			<h2>{ ticket.Title }</h2>
			@ticketActionBar(ticket.ID, actions)
			@ticketBodyEditor(ticket)
			if banner != "" {
				<p class="agent-status">{ banner }</p>
			} else if wait.Total > 0 {
				@waitProgressBanner(wait)
			}
			if len(rows) == 0 {
				<p class="empty">No messages yet.</p>
			} else {
				if threadHasDraft(rows) {
					@draftBanner()
				}
				for _, row := range rows {
					if row.Question != nil {
						@questionGroup(ticket.ID, row)
					} else if row.Divider {
						@stateSeparator(row)
					} else {
						@threadMessageRow(row)
					}
				}
			}
			@sealedSection(sealed)
			@sandboxRunBox(ticket.ID)
		} else {
			<p class="empty">Select a ticket.</p>
		}
	</main>
}

// ticketActionBar is the owner's Abandon and Restart from planning action
// bar (#65), rendered under the ticket title: a button per action
// console.ticketActions offers, both disabled with the claim note while
// actions.Held, and renders nothing when neither action is offered.
// console.js's installTicketActions confirms through an in-page dialog
// before posting, so these buttons carry no onclick of their own.
// data-ref is the confirm dialog's own wording (stripped of any
// -abandoned-K suffix, store.SplitAttemptRef).
templ ticketActionBar(ticketID int64, actions TicketActions) {
	if actions.Abandon || actions.Restart {
		<section class="ticket-actions" data-ticket={ strconv.FormatInt(ticketID, 10) } data-ref={ actions.Ref }>
			if actions.Abandon {
				<button type="button" class="ticket-abandon" data-action="abandon" disabled?={ actions.Held }>Abandon</button>
			}
			if actions.Restart {
				<button type="button" class="ticket-restart" data-action="restart" disabled?={ actions.Held }>Restart from planning</button>
			}
			if actions.Held {
				<p class="ticket-actions-note">{ store.AbandonClaimedReason }</p>
			}
			<span class="ticket-actions-error" role="alert"></span>
		</section>
	}
}

// ticketBodyEditor is the owner's ticket-body owner-edit box (#41): a
// <details class="owner-edit"> holding the stored body, posted by
// console.js's ownerEditSubmit to POST /tickets/{id}/edit. Q6's decision
// amends tickets.body only, so the tracker reference renders as a plain
// note the owner edits the issue by hand against.
// data-preserve-attr="open" keeps it open across a /stream patch while the
// owner is editing, matching questionGroup's own use of the attribute. The
// textarea's content opens with a "\n" (bug fix): the HTML parser drops
// exactly one leading newline right after a textarea's opening tag, so
// without it a stored body that itself starts with a newline would render
// one character short; the prefix makes the parser's drop a no-op either way.
templ ticketBodyEditor(ticket *store.Ticket) {
	<details class="owner-edit" data-preserve-attr="open" data-ticket={ strconv.FormatInt(ticket.ID, 10) } data-target="ticket_body">
		<summary>Ticket body</summary>
		@ownerEditClaimNote(ticket.ClaimOwner != nil)
		<textarea data-field="body" disabled?={ ticket.ClaimOwner != nil }>{ "\n" + ticket.Body }</textarea>
		<p>The tracker issue { displayRef(ticket.TrackerRef) } is not updated; edit it by hand to match.</p>
		<button type="button" class="owner-edit-save" disabled?={ ticket.ClaimOwner != nil }>Save</button>
		<span class="owner-edit-error"></span>
	</details>
}

// sealedSection is the post-gate "Sealed plan and scenarios" section (#75,
// Q1): the sealed cohort's scenario table and the stored plan, each with
// the same owner-edit boxes gateContext renders, collapsed by default.
// Renders nothing when s is nil. The host-check list is left out
// (scenariosSection's atGate false), since its text speaks of approving a
// gate that is already behind the ticket. A scenario box here sends no
// answer_question: it edits the scenario and leaves any open amended
// escalation for its own "Edit it" box or options.
templ sealedSection(s *SealedSection) {
	if s != nil {
		<details id="sealed-section" class="sealed-section" data-preserve-attr="open">
			<summary>Sealed plan and scenarios</summary>
			@scenariosSection(s.Scenarios, false)
			@PlanView(*s.Plan)
		</details>
	}
}

// waitProgressBanner is the current round's progress line (bug fix: "After
// a partial batch, Zing keeps the ticket waiting until every open question
// is answered, which is correct design, but nothing says so"), e.g.
// "Answered 1 of 2. Zing resumes the agent when every question is
// answered."
templ waitProgressBanner(wait WaitProgress) {
	<p class="wait-progress">{ fmt.Sprintf("Answered %d of %d.", wait.Answered, wait.Total) } Zing resumes the agent when every question is answered.</p>
}

// threadHasDraft reports whether any question in rows carries an unsent
// draft (bug fix): draftBanner renders only when this is true, so a ticket
// with nothing in progress shows no hint.
func threadHasDraft(rows []ThreadRow) bool {
	for _, row := range rows {
		if row.Question != nil && row.Question.HasDraft() {
			return true
		}
	}
	return false
}

// draftBanner is the Thread view's one visible line when the ticket has at
// least one unsent draft (bug fix: the owner typed a reply, the server
// saved it, but nothing on screen showed it, so the owner thought it was
// lost). Sending is keyboard-only by design (Q31, keyboard.mjs's
// isSendChord) and nothing on screen said so either; sendChordLabel below
// fills in the platform-correct chord text client-side (console.js's
// runSendChordHints, since this server-rendered page cannot know the
// browser's platform).
templ draftBanner() {
	<p class="draft-banner">Draft saved. <span class="send-chord">⌘+Enter</span> sends all drafts.</p>
}

templ stateSeparator(row ThreadRow) {
	<div class="state-separator">{ row.Body }</div>
}

templ threadMessageRow(row ThreadRow) {
	<div class={ "message message-" + row.Type } data-focus-id={ fmtFocusID("message", row.ID) }>
		<div class="meta"><span class="type">{ row.Type }</span> <span class="author">{ row.Author }</span></div>
		<div class="body">{ row.Body }</div>
	</div>
}

// questionGroup is a "question" message's <details class="q"> group (design
// section 6.6): the summary (key, title, message count, and the lifecycle
// pill), the body and recommendation (pre-rendered markdown, the Task 5
// Render helper), each kind's context region (always shown), and then,
// only while the question is still open (row.Question.Interactive, code
// review fix PR #16), the control the payload's Kind dispatches to --
// option chips for the four option kinds, one row per Item for the two
// item kinds -- plus the free reply input every open kind renders. An
// answered or resolved question shows its context and pill but none of
// those controls, since a draft against a closed question is refused
// server-side anyway (store's openQuestionForTicketTx) -- except a settled,
// still-reopenable planning question (D32, design section 22.12.2, 22.12.4,
// row.Question.ReopenPlaceholder): it keeps its free reply input, as a
// reopen box, for as long as the ticket is still in "planning", locked for
// good only once the seal moves it to "building". ticketID feeds every
// control's data-draft-ticket attribute, so each carries what Task 7's POST
// /draft needs without this package reaching back into the store itself.
// messageCountLabel labels row.Question.MessageCount plainly (bug fix: the
// summary line rendered this as a bare digit with no indication of what it
// counted, reading like stray noise after the title, e.g. "Q1 Where does
// the version string come from? 1 [waiting on you]"). The count is
// meaningful -- the question's own message plus every reply, answer,
// followup, or resolved row that names it as a parent (views.go's
// buildThreadQuestion) -- so it earns a label rather than removal, singular
// for the common one-message case a fresh, unanswered question starts at.
func messageCountLabel(n int) string {
	if n == 1 {
		return "1 message"
	}
	return strconv.Itoa(n) + " messages"
}

// recommendedKeyPattern matches a recommendation's text that opens with an
// option key (design section 22.7 item 3, bug fix: "Recommended: a:"
// against chips numbered 1 to 4): the messages/question schema's own
// Option.Key pattern is "^[a-z]$", but the payload itself carries at most
// four options (maxItems=4), so only a-d ever names a real one.
var recommendedKeyPattern = regexp.MustCompile(`^([a-d])[:.)]?(\s|$)`)

// RecommendedDisplayText maps a recommendation's leading option key to that
// option's own chip number and text (bug fix: "Recommended: a:" named
// nothing the owner could find against chips numbered 1 to 4), followed by
// the rest of the recommendation as markdown. text renders unchanged when
// it does not open with a key, or the key names no option in options (an
// item-kind question's recommendation, for instance, which never opens
// with an option letter). console.buildThreadQuestion is its one caller,
// after that question's own options are built.
func RecommendedDisplayText(text string, options []ThreadOption) string {
	loc := recommendedKeyPattern.FindStringSubmatchIndex(text)
	if loc == nil {
		return text
	}
	key := text[loc[2]:loc[3]]
	for i, o := range options {
		if o.Key != key {
			continue
		}
		rest := strings.TrimSpace(text[loc[1]:])
		out := strconv.Itoa(i+1) + ". " + o.Text + "."
		if rest != "" {
			out += " " + rest
		}
		return out
	}
	return text
}

// effectivePickedOption and effectivePickedItems resolve which key each
// control shows picked (design section 22.7 item 4, bug fix: "options
// vanish once locked"): the ticket's own in-progress draft while the
// question is still Interactive, or its last sent answer (PickedOption,
// PickedItems; views.go's buildThreadQuestion) once it is not, so the
// numbered list under a settled or answered question still shows what the
// owner picked instead of nothing at all.
func effectivePickedOption(q *ThreadQuestion) string {
	if q.Interactive {
		return q.DraftOption
	}
	return q.PickedOption
}

func effectivePickedItems(q *ThreadQuestion) map[string]response.Decision {
	if q.Interactive {
		return q.DraftItems
	}
	return q.PickedItems
}

// effectiveItemNotes mirrors effectivePickedItems for a review question's
// per-finding notes (ticket #68): the ticket's own in-progress draft notes
// while still Interactive, or its last sent answer's notes once not.
func effectiveItemNotes(q *ThreadQuestion) map[string]string {
	if q.Interactive {
		return q.DraftNotes
	}
	return q.PickedNotes
}

templ questionGroup(ticketID int64, row ThreadRow) {
	<details class="q" id={ questionDOMID(row.ID) } data-focus-id={ fmtFocusID("question", row.ID) } data-preserve-attr="open" data-kind={ row.Question.Kind } open?={ row.Question.Interactive }>
		<summary>
			<span class="q-key">{ row.Question.Key }</span>
			<span class="q-title">{ row.Question.Title }</span>
			<span class="q-count">{ messageCountLabel(row.Question.MessageCount) }</span>
			<span class="pill">{ row.Question.StateLabel }</span>
		</summary>
		<div class="q-body">
			@row.Question.BodyHTML
		</div>
		if row.Question.RecommendedHTML != nil {
			<div class="q-recommended">
				<strong>Recommended:</strong>
				@row.Question.RecommendedHTML
			</div>
		}
		switch row.Question.Kind {
			case string(response.QuestionKindGate):
				@gateContext(row.Question.Plan, row.Question.Scenarios, row.Question.Findings)
			case string(response.QuestionKindSplit):
				@splitContext(row.Question.Split)
			case string(response.QuestionKindMerge):
				@mergeContext(row.Question.PRURL)
		}
		// An amended cannot_run escalation's own prefilled scenario edit box
		// (#57 Q3): shown only while the question is still open, since
		// answering it (Accept, Edit it, or Abandon) resolves the escalation
		// this box's own answer_question would otherwise still name.
		if row.Question.Amendment != nil && row.Question.Interactive {
			@ownerEditScenarioBox(*row.Question.Amendment, row.ID, "Edit it")
		}
		// The options or items always render (bug fix: "options vanish once
		// locked", design section 22.7 item 4) -- clickable while
		// Interactive, a locked numbered list with the sent pick marked
		// picked otherwise -- whatever the question's kind or lifecycle.
		switch row.Question.Kind {
			case string(response.QuestionKindPerimeter):
				@itemRows(ticketID, row.ID, row.Question.Items, itemDecisionsPerimeter, effectivePickedItems(row.Question), nil, false, row.Question.Interactive)
			case string(response.QuestionKindReview):
				@itemRows(ticketID, row.ID, row.Question.Items, itemDecisionsReview, effectivePickedItems(row.Question), effectiveItemNotes(row.Question), true, row.Question.Interactive)
			default:
				@optionChips(ticketID, row.ID, row.Question.Options, effectivePickedOption(row.Question), row.Question.Interactive)
		}
		if row.Question.Interactive {
			if row.Question.Revisable {
				@reviseNote()
			}
			@freeReply(ticketID, row.ID, row.Question.DraftReply, defaultReplyPlaceholder)
		} else if row.Question.ReopenPlaceholder != "" {
			// D32: a settled planning question stays reopenable until the
			// seal (design section 22.12.2, 22.12.4) -- its reply box
			// renders on, with a placeholder naming what sending reopens.
			@freeReply(ticketID, row.ID, row.Question.DraftReply, row.Question.ReopenPlaceholder)
		}
		@turnsList(row.Question.Turns)
		if row.Question.SettledHTML != nil {
			@settledBlock(row.Question.SettledLabel, row.Question.SettledHTML)
		} else if !row.Question.Interactive && row.Question.AnsweredHTML != nil {
			@answeredLocked(row.Question.AnsweredHTML)
		}
	</details>
}

// turnsList renders a question's own conversation turns in order (design
// section 22.7 item 5, bug fix 10 and its D31-5 extension: each used to
// also get its own standalone ThreadRow, rendering as a "reply you"/
// "answer you" card at the bottom of the thread, detached from the
// question it actually answered). Every turn's text is already
// markdown-rendered (views.go's buildTurns, bug fix: raw backticks); a turn
// with no Author (a bare system note, such as "Resolved.") renders with no
// label. It renders after both the live controls and the locked or settled
// note -- "under its options" -- since a question can carry turns from
// while it was still open even once it is answered, resolved, or settled.
templ turnsList(turns []Turn) {
	if len(turns) > 0 {
		<div class="q-turns">
			for _, t := range turns {
				<div class="q-turn">
					if t.Author != "" {
						<span class="turn-author">{ t.Author }:</span>
					}
					@t.BodyHTML
					if t.Queued {
						<span class="pill pill-queued">queued</span>
					}
				</div>
			}
		</div>
	}
}

// settledBlock is a settled planning question's own closing line (design
// section 22.7 item 6): "Settled by <agent>:" and the agent's own decision,
// markdown-rendered, with no chips and no reply box (questionGroup already
// gates those on Interactive, false here).
templ settledBlock(label string, decisionHTML templ.Component) {
	<div class="q-settled">
		<span class="turn-author">{ label }:</span>
		@decisionHTML
	</div>
}

// reviseNote is a revisable (D30), already-answered question's own note,
// shown above its still-live controls: the question is answered, but the
// ticket still waits on this round, so a pick here still reaches the agent
// instead of being locked out the way bug 7's answeredLocked note is.
templ reviseNote() {
	<p class="q-revisable">Answered. You can change this until Zing resumes the agent.</p>
}

// answeredLocked is a closed, state=answered question's locked note (bug
// fix: "render an answered question's controls as disabled or locked with
// its answer shown, so you can't type into a closed question at all"):
// freeReply renders nothing once !Interactive, so this is the only thing
// in its place, naming what was actually sent rather than leaving the
// group looking merely inert. answeredHTML is markdown-rendered (bug fix:
// raw backticks showed literally).
templ answeredLocked(answeredHTML templ.Component) {
	<div class="q-answered">
		<span class="turn-author">Answered:</span>
		@answeredHTML
	</div>
}

// gateContext is the gate kind's context region (design section 6.6, 6.9,
// 7, D8, Task 11): the current scenario cohort's table, the above-floor
// plan-review findings' table, and the ticket's stored plan (rendered in
// full by plan.templ's PlanView), in that order -- both tables before the
// plan, per design section 7 -- or a placeholder when the ticket has no
// plan artifact yet (a gate question can only exist once a plan does, but
// the artifact read is defensive, matching mergeContext's own "No PR yet."
// fallback for a value that is not always there). scenariosSection and
// findingsSection each render nothing when their slice is empty, so a
// legacy or clean ticket shows neither table. Its class and data-context
// name are the seam Task 6 reserved and Task 8 filled.
templ gateContext(plan *RenderedPlan, scenarios []ScenarioRow, findings []FindingRow) {
	<div class="q-context gate-context" data-context="plan">
		@scenariosSection(scenarios, true)
		@findingsSection(findings)
		if plan != nil {
			@PlanView(*plan)
		} else {
			<p class="placeholder">No plan stored for this ticket yet.</p>
		}
	</div>
}

// splitContext is the split kind's context region (design section 7.2,
// Task 8): the planner's shared notes, when any, above the proposed
// children in the artifact's own order -- or a placeholder when the ticket
// has no stored children artifact yet (console.loadSplit's "not there yet"
// result, matching gateContext's own plan placeholder).
templ splitContext(split *SplitView) {
	<div class="q-context split-context" data-context="children">
		if split == nil {
			<p class="placeholder">No proposed children stored for this ticket.</p>
		} else {
			if split.NotesHTML != nil {
				<section class="split-notes">
					<h4>Shared notes</h4>
					@split.NotesHTML
				</section>
			}
			<ol class="split-children">
				for _, c := range split.Children {
					<li>
						<h4>{ c.Title }</h4>
						<span class="split-key">{ c.Key }</span>
						if len(c.DependsOn) > 0 {
							<p class="split-deps">Depends on { strings.Join(c.DependsOn, ", ") }</p>
						}
						@c.BodyHTML
					</li>
				}
			</ol>
		}
	</div>
}

// mergeContext is the merge kind's context region: the PR link, which,
// unlike gate's plan or split's children, is already on the Ticket row
// (Package 1's pr_url column), so this renders for real rather than a
// placeholder.
templ mergeContext(prURL string) {
	<div class="q-context merge-context" data-context="pr">
		if prURL != "" {
			<a href={ templ.URL(prURL) } target="_blank" rel="noopener noreferrer">{ prURL }</a>
		} else {
			<span class="empty">No PR yet.</span>
		}
	</div>
}

// pickToggleExpr is the data-on:click expression every chip and item-decision
// control shares (design section 6.6, Task 6 scope: "a picked chip toggles a
// client-visible picked state"): remove "picked" from this control's
// siblings within its own group, then add it to the one clicked. It is
// purely a client-visible affordance -- no signal write, no fetch -- since
// POST /draft does not exist until Task 7 (design section 12); Task 7 wires
// the real submit over the data-draft-* attributes these controls already
// carry.
//
// It also keeps aria-pressed in sync with the "picked" class on both sides
// of the toggle (PR review, accessibility fix): the picked state used to be
// conveyed by color alone (shell.templ's .chip.picked/.decision.picked
// border and background), which says nothing to a screen reader and nothing
// to a sighted user who cannot tell the colors apart. Every chip and
// decision button starts with aria-pressed="false" (optionChips, itemRow
// below), matching a toggle button's own ARIA state, so this expression only
// ever flips it, never introduces it.
const pickToggleExpr = "el.parentElement.querySelectorAll('.picked').forEach((c) => c.classList.remove('picked')); el.parentElement.querySelectorAll('[aria-pressed=true]').forEach((c) => c.setAttribute('aria-pressed', 'false')); el.classList.add('picked'); el.setAttribute('aria-pressed', 'true')"

// optionChips renders the four option kinds' control (design section 6.6):
// one chip per option, numbered 1..N (N up to 4, the messages/question
// schema's own maxItems) so console.js's pickChip (keys.go's "chip" action)
// finds it by data-chip-index. Each chip carries data-draft-ticket,
// data-draft-question, and data-option, the composer contract Task 7 reads
// (matching console.js's postDraft, which already reads data-draft-ticket
// and data-draft-question off the free reply input). Renders nothing when
// options is empty, so a bare free reply is what a chip-less question shows
// (design section 6.6: "A question with zero options and no items renders
// the free reply only"). pickedOption, when non-empty, is the key this
// view shows picked (console.effectivePickedOption): the ticket's own
// in-progress draft answer while interactive is true (bug fix), or its
// last sent answer once it is false (bug fix: "options vanish once
// locked", design section 22.7 item 4) -- that chip renders "picked" from
// the start, the same client-visible state pickToggleExpr would give it on
// a fresh click. A locked chip (interactive false) carries no
// data-draft-*, data-option, or data-on:click: there is nothing left to
// post a draft against, so console.js's own composer selectors (which
// query those attributes) skip it.
templ optionChips(ticketID, questionID int64, options []ThreadOption, pickedOption string, interactive bool) {
	if len(options) > 0 {
		<div class="chips">
			for i, opt := range options {
				if interactive {
					<button type="button" class={ chipClass(opt.Key, pickedOption) } aria-pressed={ pickedAttr(opt.Key == pickedOption) } data-chip-index={ strconv.Itoa(i + 1) } data-draft-ticket={ strconv.FormatInt(ticketID, 10) } data-draft-question={ strconv.FormatInt(questionID, 10) } data-option={ opt.Key } data-on:click={ pickToggleExpr }>{ strconv.Itoa(i+1) + ". " }@opt.TextHTML</button>
				} else {
					<button type="button" class={ chipClass(opt.Key, pickedOption) + " locked" } aria-pressed={ pickedAttr(opt.Key == pickedOption) } disabled>{ strconv.Itoa(i+1) + ". " }@opt.TextHTML</button>
				}
			}
		</div>
	}
}

// chipClass and pickedAttr are optionChips' and itemRow's shared
// server-side rendering of the same "picked" state pickToggleExpr toggles
// client-side (bug fix): picked reports whether this control's own key
// matches the key this view shows picked (effectivePickedOption).
func chipClass(key, pickedOption string) string {
	if pickedOption != "" && key == pickedOption {
		return "chip picked"
	}
	return "chip"
}

func pickedAttr(picked bool) string {
	if picked {
		return "true"
	}
	return "false"
}

// itemDecisionsReview is the review kind's own closed set of item decisions,
// in the order their controls render (design section 6.5, 9.2, Task 11):
// accept, drop, and discuss, matching response.FindingDecision. Both item
// kinds share accept and drop; discuss is review's alone (bug fix, #78).
var itemDecisionsReview = []response.Decision{
	response.DecisionAccept, response.DecisionDrop, response.DecisionDiscuss,
}

// itemDecisionsPerimeter is the perimeter kind's own narrower set (design
// section 9.2, Task 10, bug fix #78): a perimeter item is a file the owner
// only ever keeps or reverts, so it renders accept and drop alone, never
// discuss. SaveDraft stores a perimeter drop as reject, the word
// internal/job/building.go reads, and DisplayDecision shows that stored
// reject back as drop.
var itemDecisionsPerimeter = []response.Decision{
	response.DecisionAccept, response.DecisionDrop,
}

// itemRows renders the two item kinds' control (design section 6.6, 9.2):
// one row per Item, with decisions the allowed set for this question's
// kind. pickedItems is the ref->decision picks this view shows picked
// (console.effectivePickedItems): the ticket's own in-progress draft
// answer while interactive is true, or its last sent answer once it is
// false (bug fix: "options vanish once locked"); a ref absent from it
// renders no control picked. notes and withNotes (ticket #68) are the
// review kind's own per-finding note box: withNotes is true only for a
// review question (questionGroup), false for perimeter, which renders no
// note box or text at all.
templ itemRows(ticketID, questionID int64, items []ThreadItem, decisions []response.Decision, pickedItems map[string]response.Decision, notes map[string]string, withNotes, interactive bool) {
	if len(items) > 0 {
		<div class="items">
			for _, item := range items {
				@itemRow(ticketID, questionID, item, decisions, DisplayDecision(pickedItems[item.Ref]), notes[item.Ref], withNotes, interactive)
			}
		</div>
	}
}

// itemMarkerTrustRoot and itemMarkerStyleGuide are section 6.5's two closed
// bracketed markers a stored Item.Text may carry, matching
// internal/orchestrator/perimeter.go's own markerTrustRoot/markerStyleGuide
// literals: this package cannot import that one (no shared dependency
// direction between them), so it keeps its own copy, the same
// package-local-copy pattern internal/console/views.go already uses for
// job's marker literals.
const (
	itemMarkerTrustRoot  = "trust root"
	itemMarkerStyleGuide = "style guide"
)

// itemBuilderPrefix and itemChangeSeparator are section 6.5's own Item.Text
// wire format literals, matching internal/console/seed.go's
// perimeterItemText, which builds a stored Item.Text in exactly this shape:
// an optional "[<marker>] " prefix, then "Builder: ", then " Change: ".
const (
	itemBuilderPrefix   = "Builder: "
	itemChangeSeparator = " Change: "
)

// itemTextParts is one perimeter item's Text split into the parts itemRow
// renders separately (design section 6.5, 9.2, Task 11b): the marker (""
// when the text carries none), the builder's own reason, and the perimeter
// description of the change.
type itemTextParts struct {
	Marker, Reason, Change string
}

// splitItemText parses a stored Item.Text into itemTextParts, or reports ok
// == false when text does not follow section 6.5's format, so itemRow can
// fall back to rendering it unchanged (Task 11b: "A text that does not
// follow the format renders as it is today"). The stored text itself never
// changes; this only decides how itemRow renders it.
func splitItemText(text string) (itemTextParts, bool) {
	rest := text
	var marker string
	for _, m := range []string{itemMarkerTrustRoot, itemMarkerStyleGuide} {
		if prefix := "[" + m + "] "; strings.HasPrefix(rest, prefix) {
			marker = m
			rest = strings.TrimPrefix(rest, prefix)
			break
		}
	}
	if !strings.HasPrefix(rest, itemBuilderPrefix) {
		return itemTextParts{}, false
	}
	reason, change, ok := strings.Cut(strings.TrimPrefix(rest, itemBuilderPrefix), itemChangeSeparator)
	if !ok {
		return itemTextParts{}, false
	}
	return itemTextParts{Marker: marker, Reason: reason, Change: change}, true
}

// itemRow is one perimeter file or review finding: its path, its parsed
// text -- the marker pill when set, the builder reason, and the change,
// each its own element (design section 6.5, 9.2, Task 11b) -- or the raw
// text in one element when it does not parse, and its decision controls,
// the kind's own allowed set (design section 6.6, 8, 9.2). Each control
// carries data-draft-ticket, data-draft-question, data-item-ref, and
// data-decision, the composer contract Task 7's POST /draft reads to merge
// one ref-to-decision entry into the question's draft (design section 6.7:
// "An item answer merges one ref->decision into the ... draft's items
// map"). pickedDecision, when non-empty, is this ref's own pick this view
// shows picked (bug fix): that decision's button renders "picked" from the
// start, the same way optionChips' own pickedOption does. A locked control
// (interactive false) carries no data-draft-*, data-item-ref, data-decision,
// or data-on:click (bug fix: "options vanish once locked"). withNotes and
// note (ticket #68) add a review finding's own note box: a plain input
// carrying data-note-ticket, data-note-question, and data-item-ref of its
// own, plus an empty note hint, while interactive, or the note's text
// alone, read-only, once locked and non-empty. console.js's itemNoteBody
// reads those three attributes straight off the note box, and the row's
// already-picked decision button for the decision, since a note can only
// ever save once that button exists. withNotes is false for every other
// item kind, which renders neither.
templ itemRow(ticketID, questionID int64, item ThreadItem, decisions []response.Decision, pickedDecision response.Decision, note string, withNotes, interactive bool) {
	<div class="item-row" data-item-ref={ item.Ref }>
		<span class="item-ref">{ item.Ref }</span>
		if parts, ok := splitItemText(item.Text); ok {
			if parts.Marker != "" {
				<span class="pill item-marker">{ parts.Marker }</span>
			}
			<span class="item-reason">{ parts.Reason }</span>
			<span class="item-change">{ parts.Change }</span>
		} else {
			<span class="item-text">{ item.Text }</span>
		}
		<div class="item-decisions">
			for _, d := range decisions {
				if interactive {
					<button type="button" class={ decisionClass(d, pickedDecision) } aria-pressed={ pickedAttr(d == pickedDecision && pickedDecision != "") } data-draft-ticket={ strconv.FormatInt(ticketID, 10) } data-draft-question={ strconv.FormatInt(questionID, 10) } data-item-ref={ item.Ref } data-decision={ string(d) } data-on:click={ pickToggleExpr }>{ string(d) }</button>
				} else {
					<button type="button" class={ decisionClass(d, pickedDecision) + " locked" } aria-pressed={ pickedAttr(d == pickedDecision && pickedDecision != "") } disabled>{ string(d) }</button>
				}
			}
		</div>
		if withNotes && interactive {
			<input type="text" class="item-note" value={ note } maxlength="8000" placeholder="Note on this finding" data-note-ticket={ strconv.FormatInt(ticketID, 10) } data-note-question={ strconv.FormatInt(questionID, 10) } data-item-ref={ item.Ref }/>
			<p class="item-note-hint" aria-live="polite"></p>
		} else if withNotes && note != "" {
			<span class="item-note-text">{ note }</span>
		}
	</div>
}

// decisionClass mirrors chipClass for an item row's own decision buttons
// (bug fix): "decision picked" when d is the ref's own picked decision,
// "decision" otherwise.
func decisionClass(d, pickedDecision response.Decision) string {
	if pickedDecision != "" && d == pickedDecision {
		return "decision picked"
	}
	return "decision"
}

// freeReply is the free reply input every question kind renders beneath its
// control (design section 6.6: "Every question kind ... also renders a free
// reply input"). data-draft-ticket and data-draft-question are exactly what
// console.js's postDraft (keys.go's Enter-in-input "draft" action) already
// reads off document.activeElement, so Enter inside this input is wired
// today; only the server side (POST /draft, Task 7) is missing. draftReply
// is the ticket's own in-progress draft reply text against this question,
// if any (bug fix): rendered as the input's starting value, so a
// saved-but-unsent reply survives a reload or a later patch instead of
// looking lost, and reply-hint says what sends it, since sending is
// keyboard-only (Q31) and nothing on screen said so before this fix.
//
// .draft-saved (bug fix 11: Enter saved the draft -- the serve log and the
// store both showed it -- but the box emptied and stayed empty, since
// handleDraft (answer.go) publishes no bus wake, so nothing ever re-rendered
// the box with the now-saved text) starts empty, same as .draft-conflict
// below, and is console.js's postDraftRequest's own "Saved." target: it no
// longer clears the input on Enter, so this is the only on-screen
// confirmation that the save actually landed.
//
// .draft-conflict (bug fix: Enter on a question that closed out from under
// a stale, still-rendered reply box got a 409 with the typed text silently
// gone) starts empty -- :empty hides it (shell.templ) -- and is console.js's
// own showDraftConflict target, a sibling .reply-input a 409 can always
// find via el.closest('.reply').
// defaultReplyPlaceholder is an open question's own free reply input's
// placeholder (unchanged from before D32). A settled, reopenable planning
// question's reply box (questionGroup) passes its own ReopenPlaceholder
// instead -- "Write to reopen Q1", with "and withdraw the gate" appended
// while a gate question is open (design section 22.12.2, 22.12.4).
const defaultReplyPlaceholder = "Reply…"

templ freeReply(ticketID, questionID int64, draftReply, placeholder string) {
	<div class="reply">
		<input type="text" class="reply-input" placeholder={ placeholder } aria-label="Reply" value={ draftReply } data-draft-ticket={ strconv.FormatInt(ticketID, 10) } data-draft-question={ strconv.FormatInt(questionID, 10) }/>
		<p class="reply-hint">Saved as a draft. <span class="send-chord">⌘+Enter</span> sends.</p>
		<p class="draft-saved" aria-live="polite"></p>
		<p class="draft-conflict" aria-live="polite"></p>
	</div>
}

// fmtFocusID builds a data-focus-id value: a namespace ("message" or
// "question") and the row's id, matching console.js's own
// "namespace:id" convention (openFocused, markRead, pickChip).
func fmtFocusID(namespace string, id int64) string {
	return namespace + ":" + strconv.FormatInt(id, 10)
}

// questionDOMID is a question's DOM id (bug fix): Datastar's morph
// (datastar.js:9) pairs elements by id before falling back to position, so
// a stable id keeps one question's open state from landing on another's
// when a row is inserted above it.
func questionDOMID(id int64) string {
	return "question-" + strconv.FormatInt(id, 10)
}

// sandboxRunBox is the owner's "run a command in this ticket's sandbox"
// form (POST /tickets/{id}/sandbox-run): a text box for the command and a
// Run button, no <form> element, matching pickupBox's own plain-button
// shape (mw.go rejects every plain-form content type). console.js's
// runInSandbox posts it and shows the result in the shell's own
// #sandbox-run-result dialog (shell.templ), outside every region /stream
// re-renders.
templ sandboxRunBox(ticketID int64) {
	<section class="sandbox-run-box" data-sandbox-run-ticket={ strconv.FormatInt(ticketID, 10) }>
		<label for="sandbox-run-cmd">Run a command in this ticket's sandbox</label>
		<input type="text" id="sandbox-run-cmd" class="sandbox-run-cmd" autocomplete="off" spellcheck="false" aria-label="Shell command"/>
		<button type="submit">Run</button>
	</section>
}
