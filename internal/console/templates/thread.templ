package templates

import "zing/internal/store"

// Thread renders the #main region for view=thread (design section 6.6,
// Task 3 scope): the ticket's messages in id order, read only. ticket is
// nil when open is 0 or names no ticket. A "question" message renders as a
// read-only group (title, body, recommendation, options); every other
// type, including the "state" separator, renders as a plain row with its
// already-decoded Body (internal/console/views.go's displayBody). The
// interactive chips and composer are Tasks 6 and 7.
templ Thread(ticket *store.Ticket, rows []ThreadRow) {
	<main id="main" class="view-thread">
		if ticket != nil {
			<h2>{ ticket.Title }</h2>
			if len(rows) == 0 {
				<p class="empty">No messages yet.</p>
			} else {
				for _, row := range rows {
					if row.Question != nil {
						@questionGroup(row)
					} else if row.IsState() {
						@stateSeparator(row)
					} else {
						@threadMessageRow(row)
					}
				}
			}
		} else {
			<p class="empty">Select a ticket.</p>
		}
	</main>
}

templ stateSeparator(row ThreadRow) {
	<div class="state-separator">{ row.Body }</div>
}

templ threadMessageRow(row ThreadRow) {
	<div class={ "message message-" + row.Type }>
		<div class="meta"><span class="type">{ row.Type }</span> <span class="author">{ row.Author }</span></div>
		<div class="body">{ row.Body }</div>
	</div>
}

// questionGroup is the read-only detail a question message renders in
// place of a plain row: its title and pill in the summary, then its body,
// recommendation, and options -- no chip buttons, no composer (design
// section 6.6, Task 3 scope: "WITHOUT the interactive composer or chips").
templ questionGroup(row ThreadRow) {
	<details class="q">
		<summary>
			<span class="q-title">{ row.Question.Title }</span>
			<span class="pill">{ row.Question.StateLabel }</span>
		</summary>
		<div class="q-body">{ row.Question.Body }</div>
		if row.Question.Recommended != "" {
			<div class="q-recommended"><strong>Recommended:</strong> { row.Question.Recommended }</div>
		}
		if len(row.Question.Options) > 0 {
			<ul class="q-options">
				for _, opt := range row.Question.Options {
					<li>{ opt.Key }: { opt.Text }</li>
				}
			</ul>
		}
	</details>
}
