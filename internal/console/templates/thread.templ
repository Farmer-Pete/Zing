package templates

import (
	"strconv"
	"strings"

	"zing/internal/response"
	"zing/internal/store"
)

// Thread renders the #main region for view=thread (design section 6.6):
// the ticket's messages in id order, read only except for the question
// groups, which dispatch on QuestionPayload.Kind into interactive controls
// (Task 6). ticket is nil when open is 0 or names no ticket.
templ Thread(ticket *store.Ticket, rows []ThreadRow) {
	<main id="main" class="view-thread">
		if ticket != nil {
			<h2>{ ticket.Title }</h2>
			if len(rows) == 0 {
				<p class="empty">No messages yet.</p>
			} else {
				if threadHasDraft(rows) {
					@draftBanner()
				}
				for _, row := range rows {
					if row.Question != nil {
						@questionGroup(ticket.ID, row)
					} else if row.IsState() {
						@stateSeparator(row)
					} else {
						@threadMessageRow(row)
					}
				}
			}
		} else {
			<p class="empty">Select a ticket.</p>
		}
	</main>
}

// threadHasDraft reports whether any question in rows carries an unsent
// draft (bug fix): draftBanner renders only when this is true, so a ticket
// with nothing in progress shows no hint.
func threadHasDraft(rows []ThreadRow) bool {
	for _, row := range rows {
		if row.Question != nil && row.Question.HasDraft() {
			return true
		}
	}
	return false
}

// draftBanner is the Thread view's one visible line when the ticket has at
// least one unsent draft (bug fix: the owner typed a reply, the server
// saved it, but nothing on screen showed it, so the owner thought it was
// lost). Sending is keyboard-only by design (Q31, keyboard.mjs's
// isSendChord) and nothing on screen said so either; sendChordLabel below
// fills in the platform-correct chord text client-side (console.js's
// runSendChordHints, since this server-rendered page cannot know the
// browser's platform).
templ draftBanner() {
	<p class="draft-banner">Draft saved. <span class="send-chord">⌘+Enter</span> sends all drafts.</p>
}

templ stateSeparator(row ThreadRow) {
	<div class="state-separator">{ row.Body }</div>
}

templ threadMessageRow(row ThreadRow) {
	<div class={ "message message-" + row.Type } data-focus-id={ fmtFocusID("message", row.ID) }>
		<div class="meta"><span class="type">{ row.Type }</span> <span class="author">{ row.Author }</span></div>
		<div class="body">{ row.Body }</div>
	</div>
}

// questionGroup is a "question" message's <details class="q"> group (design
// section 6.6): the summary (key, title, message count, and the lifecycle
// pill), the body and recommendation (pre-rendered markdown, the Task 5
// Render helper), each kind's context region (always shown), and then,
// only while the question is still open (row.Question.Interactive, code
// review fix PR #16), the control the payload's Kind dispatches to --
// option chips for the four option kinds, one row per Item for the two
// item kinds -- plus the free reply input every open kind renders. An
// answered or resolved question shows its context and pill but none of
// those controls, since a draft against a closed question is refused
// server-side anyway (store's openQuestionForTicketTx). ticketID feeds
// every control's data-draft-ticket attribute, so each carries what Task
// 7's POST /draft needs without this package reaching back into the store
// itself.
// messageCountLabel labels row.Question.MessageCount plainly (bug fix: the
// summary line rendered this as a bare digit with no indication of what it
// counted, reading like stray noise after the title, e.g. "Q1 Where does
// the version string come from? 1 [waiting on you]"). The count is
// meaningful -- the question's own message plus every reply, answer,
// followup, or resolved row that names it as a parent (views.go's
// buildThreadQuestion) -- so it earns a label rather than removal, singular
// for the common one-message case a fresh, unanswered question starts at.
func messageCountLabel(n int) string {
	if n == 1 {
		return "1 message"
	}
	return strconv.Itoa(n) + " messages"
}

templ questionGroup(ticketID int64, row ThreadRow) {
	<details class="q" data-focus-id={ fmtFocusID("question", row.ID) }>
		<summary>
			<span class="q-key">{ row.Question.Key }</span>
			<span class="q-title">{ row.Question.Title }</span>
			<span class="q-count">{ messageCountLabel(row.Question.MessageCount) }</span>
			<span class="pill">{ row.Question.StateLabel }</span>
		</summary>
		<div class="q-body">
			@row.Question.BodyHTML
		</div>
		if row.Question.RecommendedHTML != nil {
			<div class="q-recommended">
				<strong>Recommended:</strong>
				@row.Question.RecommendedHTML
			</div>
		}
		switch row.Question.Kind {
			case string(response.QuestionKindGate):
				@gateContext(row.Question.Plan, row.Question.Scenarios, row.Question.Findings)
			case string(response.QuestionKindSplit):
				@splitContext()
			case string(response.QuestionKindMerge):
				@mergeContext(row.Question.PRURL)
		}
		if row.Question.Interactive {
			if row.Question.Revisable {
				@reviseNote()
			}
			switch row.Question.Kind {
				case string(response.QuestionKindPerimeter):
					@itemRows(ticketID, row.ID, row.Question.Items, itemDecisionsPerimeter, row.Question.DraftItems)
				case string(response.QuestionKindReview):
					@itemRows(ticketID, row.ID, row.Question.Items, itemDecisionsReview, row.Question.DraftItems)
				default:
					@optionChips(ticketID, row.ID, row.Question.Options, row.Question.DraftOption)
			}
			@freeReply(ticketID, row.ID, row.Question.DraftReply)
		} else if row.Question.AnsweredText != "" {
			@answeredLocked(row.Question.AnsweredText)
		}
	</details>
}

// reviseNote is a revisable (D30), already-answered question's own note,
// shown above its still-live controls: the question is answered, but the
// ticket still waits on this round, so a pick here still reaches the agent
// instead of being locked out the way bug 7's answeredLocked note is.
templ reviseNote() {
	<p class="q-revisable">Answered. You can change this until Zing resumes the agent.</p>
}

// answeredLocked is a closed, state=answered question's locked note (bug
// fix: "render an answered question's controls as disabled or locked with
// its answer shown, so you can't type into a closed question at all"):
// optionChips/itemRows/freeReply render nothing once !Interactive, so this
// is the only thing in their place, naming what was actually sent rather
// than leaving the group looking merely inert.
templ answeredLocked(answeredText string) {
	<p class="q-answered">Answered: { answeredText }</p>
}

// gateContext is the gate kind's context region (design section 6.6, 6.9,
// 7, D8, Task 11): the current scenario cohort's table, the above-floor
// plan-review findings' table, and the ticket's stored plan (rendered in
// full by plan.templ's PlanView), in that order -- both tables before the
// plan, per design section 7 -- or a placeholder when the ticket has no
// plan artifact yet (a gate question can only exist once a plan does, but
// the artifact read is defensive, matching mergeContext's own "No PR yet."
// fallback for a value that is not always there). scenariosSection and
// findingsSection each render nothing when their slice is empty, so a
// legacy or clean ticket shows neither table. Its class and data-context
// name are the seam Task 6 reserved and Task 8 filled.
templ gateContext(plan *RenderedPlan, scenarios []ScenarioRow, findings []FindingRow) {
	<div class="q-context gate-context" data-context="plan">
		@scenariosSection(scenarios)
		@findingsSection(findings)
		if plan != nil {
			@PlanView(*plan)
		} else {
			<p class="placeholder">No plan stored for this ticket yet.</p>
		}
	</div>
}

// splitContext is the split kind's context region: the proposed children,
// deferred to the same later-task seam as gateContext, since no store read
// for a ticket's proposed children exists yet (design section 7.2 names none;
// Task 6 keeps this minimal rather than reaching for one).
templ splitContext() {
	<div class="q-context split-context" data-context="children">
		<p class="placeholder">The proposed children render here once split has a producer.</p>
	</div>
}

// mergeContext is the merge kind's context region: the PR link, which,
// unlike gate's plan or split's children, is already on the Ticket row
// (Package 1's pr_url column), so this renders for real rather than a
// placeholder.
templ mergeContext(prURL string) {
	<div class="q-context merge-context" data-context="pr">
		if prURL != "" {
			<a href={ templ.URL(prURL) } target="_blank" rel="noopener noreferrer">{ prURL }</a>
		} else {
			<span class="empty">No PR yet.</span>
		}
	</div>
}

// pickToggleExpr is the data-on:click expression every chip and item-decision
// control shares (design section 6.6, Task 6 scope: "a picked chip toggles a
// client-visible picked state"): remove "picked" from this control's
// siblings within its own group, then add it to the one clicked. It is
// purely a client-visible affordance -- no signal write, no fetch -- since
// POST /draft does not exist until Task 7 (design section 12); Task 7 wires
// the real submit over the data-draft-* attributes these controls already
// carry.
//
// It also keeps aria-pressed in sync with the "picked" class on both sides
// of the toggle (PR review, accessibility fix): the picked state used to be
// conveyed by color alone (shell.templ's .chip.picked/.decision.picked
// border and background), which says nothing to a screen reader and nothing
// to a sighted user who cannot tell the colors apart. Every chip and
// decision button starts with aria-pressed="false" (optionChips, itemRow
// below), matching a toggle button's own ARIA state, so this expression only
// ever flips it, never introduces it.
const pickToggleExpr = "el.parentElement.querySelectorAll('.picked').forEach((c) => c.classList.remove('picked')); el.parentElement.querySelectorAll('[aria-pressed=true]').forEach((c) => c.setAttribute('aria-pressed', 'false')); el.classList.add('picked'); el.setAttribute('aria-pressed', 'true')"

// optionChips renders the four option kinds' control (design section 6.6):
// one chip per option, numbered 1..N (N up to 4, the messages/question
// schema's own maxItems) so console.js's pickChip (keys.go's "chip" action)
// finds it by data-chip-index. Each chip carries data-draft-ticket,
// data-draft-question, and data-option, the composer contract Task 7 reads
// (matching console.js's postDraft, which already reads data-draft-ticket
// and data-draft-question off the free reply input). Renders nothing when
// options is empty, so a bare free reply is what a chip-less question shows
// (design section 6.6: "A question with zero options and no items renders
// the free reply only"). draftOption, when non-empty, is the ticket's own
// in-progress draft answer's picked key (bug fix): that chip renders
// "picked" from the start, the same client-visible state pickToggleExpr
// would give it on a fresh click, so a saved-but-unsent pick survives a
// reload or a later patch instead of looking lost.
templ optionChips(ticketID, questionID int64, options []ThreadOption, draftOption string) {
	if len(options) > 0 {
		<div class="chips">
			for i, opt := range options {
				<button type="button" class={ chipClass(opt.Key, draftOption) } aria-pressed={ pickedAttr(opt.Key == draftOption) } data-chip-index={ strconv.Itoa(i + 1) } data-draft-ticket={ strconv.FormatInt(ticketID, 10) } data-draft-question={ strconv.FormatInt(questionID, 10) } data-option={ opt.Key } data-on:click={ pickToggleExpr }>{ strconv.Itoa(i+1) + ". " + opt.Text }</button>
			}
		</div>
	}
}

// chipClass and pickedAttr are optionChips' and itemRow's shared
// server-side rendering of the same "picked" state pickToggleExpr toggles
// client-side (bug fix): picked reports whether this control's own key
// matches the ticket's in-progress draft.
func chipClass(key, draftOption string) string {
	if draftOption != "" && key == draftOption {
		return "chip picked"
	}
	return "chip"
}

func pickedAttr(picked bool) string {
	if picked {
		return "true"
	}
	return "false"
}

// itemDecisionsReview is the review kind's own closed set of item decisions,
// in the order their controls render (design section 6.5, 9.2, Task 11):
// accept, drop, and discuss, matching response.FindingDecision -- never
// reject, which is perimeter's own decision alone.
var itemDecisionsReview = []response.Decision{
	response.DecisionAccept, response.DecisionDrop, response.DecisionDiscuss,
}

// itemDecisionsPerimeter is the perimeter kind's own narrower set (design
// section 9.2, Task 10): a perimeter item is a file the owner only ever
// keeps or reverts, so it renders accept and reject alone, never drop or
// discuss.
var itemDecisionsPerimeter = []response.Decision{
	response.DecisionAccept, response.DecisionReject,
}

// itemRows renders the two item kinds' control (design section 6.6, 9.2):
// one row per Item, with decisions the allowed set for this question's
// kind. draftItems is the ticket's own in-progress draft answer's
// ref->decision picks, if any (bug fix); a ref absent from it renders no
// control picked.
templ itemRows(ticketID, questionID int64, items []ThreadItem, decisions []response.Decision, draftItems map[string]response.Decision) {
	if len(items) > 0 {
		<div class="items">
			for _, item := range items {
				@itemRow(ticketID, questionID, item, decisions, draftItems[item.Ref])
			}
		</div>
	}
}

// itemMarkerTrustRoot and itemMarkerStyleGuide are section 6.5's two closed
// bracketed markers a stored Item.Text may carry, matching
// internal/orchestrator/perimeter.go's own markerTrustRoot/markerStyleGuide
// literals: this package cannot import that one (no shared dependency
// direction between them), so it keeps its own copy, the same
// package-local-copy pattern internal/console/views.go already uses for
// job's marker literals.
const (
	itemMarkerTrustRoot  = "trust root"
	itemMarkerStyleGuide = "style guide"
)

// itemBuilderPrefix and itemChangeSeparator are section 6.5's own Item.Text
// wire format literals, matching internal/console/seed.go's
// perimeterItemText, which builds a stored Item.Text in exactly this shape:
// an optional "[<marker>] " prefix, then "Builder: ", then " Change: ".
const (
	itemBuilderPrefix   = "Builder: "
	itemChangeSeparator = " Change: "
)

// itemTextParts is one perimeter item's Text split into the parts itemRow
// renders separately (design section 6.5, 9.2, Task 11b): the marker (""
// when the text carries none), the builder's own reason, and the perimeter
// description of the change.
type itemTextParts struct {
	Marker, Reason, Change string
}

// splitItemText parses a stored Item.Text into itemTextParts, or reports ok
// == false when text does not follow section 6.5's format, so itemRow can
// fall back to rendering it unchanged (Task 11b: "A text that does not
// follow the format renders as it is today"). The stored text itself never
// changes; this only decides how itemRow renders it.
func splitItemText(text string) (itemTextParts, bool) {
	rest := text
	var marker string
	for _, m := range []string{itemMarkerTrustRoot, itemMarkerStyleGuide} {
		if prefix := "[" + m + "] "; strings.HasPrefix(rest, prefix) {
			marker = m
			rest = strings.TrimPrefix(rest, prefix)
			break
		}
	}
	if !strings.HasPrefix(rest, itemBuilderPrefix) {
		return itemTextParts{}, false
	}
	reason, change, ok := strings.Cut(strings.TrimPrefix(rest, itemBuilderPrefix), itemChangeSeparator)
	if !ok {
		return itemTextParts{}, false
	}
	return itemTextParts{Marker: marker, Reason: reason, Change: change}, true
}

// itemRow is one perimeter file or review finding: its path, its parsed
// text -- the marker pill when set, the builder reason, and the change,
// each its own element (design section 6.5, 9.2, Task 11b) -- or the raw
// text in one element when it does not parse, and its decision controls,
// the kind's own allowed set (design section 6.6, 8, 9.2). Each control
// carries data-draft-ticket, data-draft-question, data-item-ref, and
// data-decision, the composer contract Task 7's POST /draft reads to merge
// one ref-to-decision entry into the question's draft (design section 6.7:
// "An item answer merges one ref->decision into the ... draft's items
// map"). draftDecision, when non-empty, is this ref's own pick in the
// ticket's in-progress draft answer, if any (bug fix): that decision's
// button renders "picked" from the start, the same way optionChips' own
// draftOption does.
templ itemRow(ticketID, questionID int64, item ThreadItem, decisions []response.Decision, draftDecision response.Decision) {
	<div class="item-row" data-item-ref={ item.Ref }>
		<span class="item-ref">{ item.Ref }</span>
		if parts, ok := splitItemText(item.Text); ok {
			if parts.Marker != "" {
				<span class="pill item-marker">{ parts.Marker }</span>
			}
			<span class="item-reason">{ parts.Reason }</span>
			<span class="item-change">{ parts.Change }</span>
		} else {
			<span class="item-text">{ item.Text }</span>
		}
		<div class="item-decisions">
			for _, d := range decisions {
				<button type="button" class={ decisionClass(d, draftDecision) } aria-pressed={ pickedAttr(d == draftDecision && draftDecision != "") } data-draft-ticket={ strconv.FormatInt(ticketID, 10) } data-draft-question={ strconv.FormatInt(questionID, 10) } data-item-ref={ item.Ref } data-decision={ string(d) } data-on:click={ pickToggleExpr }>{ string(d) }</button>
			}
		</div>
	</div>
}

// decisionClass mirrors chipClass for an item row's own decision buttons
// (bug fix): "decision picked" when d is the ref's in-progress draft pick,
// "decision" otherwise.
func decisionClass(d, draftDecision response.Decision) string {
	if draftDecision != "" && d == draftDecision {
		return "decision picked"
	}
	return "decision"
}

// freeReply is the free reply input every question kind renders beneath its
// control (design section 6.6: "Every question kind ... also renders a free
// reply input"). data-draft-ticket and data-draft-question are exactly what
// console.js's postDraft (keys.go's Enter-in-input "draft" action) already
// reads off document.activeElement, so Enter inside this input is wired
// today; only the server side (POST /draft, Task 7) is missing. draftReply
// is the ticket's own in-progress draft reply text against this question,
// if any (bug fix): rendered as the input's starting value, so a
// saved-but-unsent reply survives a reload or a later patch instead of
// looking lost, and reply-hint says what sends it, since sending is
// keyboard-only (Q31) and nothing on screen said so before this fix.
//
// .draft-conflict (bug fix: Enter on a question that closed out from under
// a stale, still-rendered reply box got a 409 with the typed text silently
// gone) starts empty -- :empty hides it (shell.templ) -- and is console.js's
// own showDraftConflict target, a sibling .reply-input a 409 can always
// find via el.closest('.reply').
templ freeReply(ticketID, questionID int64, draftReply string) {
	<div class="reply">
		<input type="text" class="reply-input" placeholder="Reply…" aria-label="Reply" value={ draftReply } data-draft-ticket={ strconv.FormatInt(ticketID, 10) } data-draft-question={ strconv.FormatInt(questionID, 10) }/>
		<p class="reply-hint">Saved as a draft. <span class="send-chord">⌘+Enter</span> sends.</p>
		<p class="draft-conflict" aria-live="polite"></p>
	</div>
}

// fmtFocusID builds a data-focus-id value: a namespace ("message" or
// "question") and the row's id, matching console.js's own
// "namespace:id" convention (openFocused, markRead, pickChip).
func fmtFocusID(namespace string, id int64) string {
	return namespace + ":" + strconv.FormatInt(id, 10)
}
