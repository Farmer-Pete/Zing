package templates

// Shell renders the "/" page (design section 6.3, 7.1, 6a): the palette,
// the four regions (#alerts, #nav, #main, #rail, each rendered once by the
// caller for the shell's default signals) and the #stream-ctl bridge that
// hands navigation over to GET /stream. nav, main, rail, and alerts are the
// same templ.Component values GET /stream itself patches with on every
// frame, so the very first paint and the live stream render through one
// code path. #alerts sits above the .layout grid, not inside it: it is a
// live warning strip across the whole page, not one of the three
// navigation columns.
//
// The body's data-signals declares the three navigation signals with their
// defaults (design section 6.3): the first /stream request this fires
// always carries real state, never an empty query. #stream-ctl sits outside
// #nav, #main, and #rail so a region morph never re-initializes it, and it
// is the one element every /stream request goes through (data-init for the
// first, data-on:zing-nav for every navigation after), so Datastar's
// requestCancellation (default "auto", keyed by trigger element) aborts the
// prior stream before the next one starts.
//
// The head loads the vendored mermaid UMD bundle with a classic, non-module
// script tag (design section 6.10, v10 change log): the vendored build
// (static/ASSETS.md) is esbuild's self-contained UMD output, which sets the
// `mermaid` global directly and needs no module resolution, unlike the
// ES-module entry point Task 1 first vendored and Task 5 replaced. Loading
// it here, once, is the only mermaid script on the page: render.go's
// goldmark-diagram wiring never emits a second one (design section 6.10).
//
// #sandbox-run-result (console.js's runInSandbox) sits after .layout, like
// #stream-ctl below it: a client-owned dialog no /stream patch ever
// touches, so the owner's sandbox-run result survives every region morph
// until the owner closes it or navigates away.
//
// console.js loads before datastar.js (the reconnect plan): its own
// datastar-fetch listener (installStreamWatch) must already be bound before
// datastar.js processes #stream-ctl's data-init and fires /stream's very
// first `started` event, or that event -- and the "live" settle timer it
// starts -- would be missed. Both /stream calls pass {retryMaxCount: 0},
// handing every reconnect attempt to console.js instead of to Datastar's
// own retry, which fires no `started` event per retry and so gives the
// client no way to tell when a retry has actually succeeded.
templ Shell(nav, main, rail, alerts templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Zing</title>
			@palette()
			<script src="/static/mermaid.js"></script>
		</head>
		<body data-signals="{view: 'inbox', open: 0, project: 0}">
			@alerts
			<div class="layout">
				@nav
				@main
				@rail
			</div>
			<dialog id="sandbox-run-result" class="sandbox-run-result">
				<h3 class="sandbox-run-title"></h3>
				<p class="sandbox-run-exit"></p>
				<pre class="sandbox-run-output"></pre>
				<button type="button" class="sandbox-run-close">Close</button>
			</dialog>
			<span
				id="stream-ctl"
				style="display:none"
				data-init="@get('/stream', {retryMaxCount: 0})"
				data-on:zing-nav="$view = evt.detail.view; $open = evt.detail.open; $project = evt.detail.project; @get('/stream', {retryMaxCount: 0})"
			></span>
			<script type="module" src="/static/console.js"></script>
			<script type="module" src="/static/datastar.js"></script>
		</body>
	</html>
}

// palette is the console's color and layout system: a dark, low-chroma
// ground with one accent hue, and a three-column grid (#nav, #main, #rail)
// matching the mock's layout (design section 0, "fidelity to the approved
// mock"; section 6.3's region scheme).
templ palette() {
	<style>
		:root {
			--zing-bg: #14161c;
			--zing-surface: #1c1f28;
			--zing-border: #2b2f3a;
			--zing-text: #e4e6ec;
			--zing-text-dim: #9aa0b0;
			--zing-accent: #6ea8fe;
			--zing-warn: #f0b429;
			--zing-danger: #f0616d;
			/* The mock's teal accent (PKG4-DESIGN.html: --accent #0f766e
			   light / #5ec8bd dark), reserved for a user-picked selection so
			   it reads distinctly from --zing-accent's blue focus ring. */
			--zing-picked: #2dd4bf;
			--zing-picked-soft: #163430;
		}
		* { box-sizing: border-box; }
		body {
			margin: 0;
			height: 100vh;
			display: flex;
			flex-direction: column;
			background: var(--zing-bg);
			color: var(--zing-text);
			font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		}
		#alerts { flex: none; }
		/* The columns scroll on their own (#nav/#main/#rail's overflow-y:
		   auto below); the page itself never scrolls vertically, so the
		   sidebar stays on screen through a thread of any length. */
		.layout {
			display: grid;
			grid-template-columns: 18rem 1fr 18rem;
			grid-template-rows: minmax(0, 1fr);
			flex: 1;
			min-height: 0;
		}
		/* #alerts (design section 6a, D8): a live strip above .layout, empty
		   (and so invisible, no border/padding to show) when there are no
		   WARN-or-above lines. Bug fix: the strip holds up to alertsLimit (20)
		   lines in normal flow, so every new line pushed .layout down.
		   max-height caps it at about three .alert-line rows (5.5rem, padding
		   and border included under border-box) and the rest scroll inside. */
		#alerts:empty { display: none; }
		.alert-lines {
			list-style: none;
			margin: 0;
			padding: 0.5rem 1rem;
			border-bottom: 1px solid var(--zing-border);
			background: var(--zing-surface);
			max-height: 5.5rem;
			overflow-y: auto;
		}
		.alert-line {
			display: flex;
			align-items: baseline;
			gap: 0.5rem;
			padding: 0.125rem 0;
			font-size: 0.8rem;
		}
		.alert-time, .alert-ticket { color: var(--zing-text-dim); }
		.alert-level { text-transform: uppercase; font-size: 0.7rem; }
		.alert-level-WARN { color: var(--zing-warn); }
		.alert-level-ERROR { color: var(--zing-danger); }
		#nav {
			border-right: 1px solid var(--zing-border);
			padding: 1rem;
			overflow-y: auto;
		}
		#main { padding: 1.5rem; overflow-y: auto; overflow-x: hidden; }
		/* Bug fix 17: a wide plan table or a long code line used to force a
		   horizontal scrollbar under the whole thread, because neither a
		   table nor a pre shrinks to its container on its own. Each gets its
		   own scroll box instead (display: block turns a table into a
		   container overflow-x can actually apply to), so the page itself
		   never scrolls sideways. */
		#main table { display: block; max-width: 100%; overflow-x: auto; }
		#main pre { max-width: 100%; overflow-x: auto; }
		/* .change-block (bug fix: the plan's Changes table rendered one row
		   per change, with Before/After whole source files in a <pre> table
		   cell; a row grew hundreds of pixels tall and mostly empty in the
		   ~800px thread column). plan.templ's changeBlocks renders one block
		   per change instead, reusing .run-fields below for its Callers/
		   Callees/Simple call list; .change-code is its own scroll box so a
		   long line never widens the page past #main pre's own rule above. */
		.change-block {
			border: 1px solid var(--zing-border);
			border-radius: 0.5rem;
			padding: 0.75rem 1rem;
			margin-bottom: 0.75rem;
			background: var(--zing-surface);
		}
		.change-block h4 { margin: 0 0 0.375rem; }
		.change-code {
			margin: 0;
			max-width: 100%;
			overflow-x: auto;
			background: var(--zing-bg);
			border: 1px solid var(--zing-border);
			border-radius: 0.375rem;
			padding: 0.5rem;
		}
		#rail {
			border-left: 1px solid var(--zing-border);
			padding: 1rem;
			overflow-y: auto;
		}
		h2, h3 { margin-top: 0; }
		.empty { color: var(--zing-text-dim); }
		/* The sandbox indicator (design section 9.2, Task 15): renders only
		   while the sandbox is unavailable (nav.templ's own sandboxReason !=
		   "" guard), so red is enough on its own -- there is no "on" state of
		   this span to distinguish it from. */
		.sandbox-off {
			display: block;
			margin-bottom: 0.5rem;
			color: var(--zing-danger);
			font-size: 0.8rem;
		}
		.nav-link {
			display: flex;
			justify-content: space-between;
			align-items: center;
			width: 100%;
			padding: 0.375rem 0.5rem;
			margin-bottom: 0.125rem;
			background: var(--zing-surface);
			border: 1px solid var(--zing-border);
			border-radius: 0.375rem;
			color: inherit;
			text-decoration: none;
		}
		.nav-link:hover { border-color: var(--zing-accent); }
		/* threadLink's own "selected" class (bug fix, nav.templ): the open
		   thread's row stays visibly marked across every #nav patch, since
		   it is server-rendered HTML rather than the clicked anchor's
		   native focus outline a patch is not guaranteed to preserve. */
		.nav-thread.selected {
			border-color: var(--zing-accent);
			background: var(--zing-picked-soft);
		}
		.badge, .pill, .item-marker {
			font-size: 0.75rem;
			padding: 0.125rem 0.5rem;
			border-radius: 999px;
			background: var(--zing-border);
			color: var(--zing-text-dim);
		}
		.badge-blocking, .pill-waiting, .pill-interrupted { background: var(--zing-warn); color: var(--zing-bg); }
		.badge-unread { background: var(--zing-accent); color: var(--zing-bg); }
		.ib-thread, .ticket-row, .message, .q {
			border: 1px solid var(--zing-border);
			border-radius: 0.5rem;
			padding: 0.75rem 1rem;
			margin-bottom: 0.75rem;
			background: var(--zing-surface);
		}
		.ib-thread-row, .ticket-row {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}
		a.ticket-row, a.ib-thread-row {
			color: inherit;
			text-decoration: none;
			cursor: pointer;
		}
		a.ticket-row:hover {
			border-color: var(--zing-accent);
		}
		a.ib-thread-row:hover {
			color: var(--zing-accent);
		}
		.ib-q {
			margin: 0.375rem 0 0 1rem;
			color: var(--zing-text-dim);
			font-size: 0.85rem;
		}
		.meta { color: var(--zing-text-dim); font-size: 0.8rem; margin-bottom: 0.25rem; }
		.state-separator {
			text-align: center;
			color: var(--zing-text-dim);
			font-size: 0.8rem;
			margin: 0.75rem 0;
			white-space: pre-wrap;
		}
		/* The focus ring console.js's keyboard layer moves with j/k
		   (design section 6.4): a client-only class, never a Datastar
		   signal, so a patch never needs to know about it. */
		.focus { outline: 2px solid var(--zing-accent); outline-offset: 2px; }

		/* The "picked" state pickToggleExpr (thread.templ) toggles on an
		   option chip or an item-decision button (design section 6.6): a
		   client-only class, matching .focus above, so a selected control
		   reads clearly before POST /draft's response round trips back
		   through /stream. pickToggleExpr keeps aria-pressed in sync with
		   this class (PR review, accessibility fix), so a screen reader
		   announces the pick even though the color change alone says
		   nothing to it; the ::after checkmark below is the same fix for a
		   sighted user who cannot distinguish the border/background color
		   shift (e.g. color-blindness), so picked is never conveyed by
		   color alone. */
		.chip.picked, .decision.picked {
			border-color: var(--zing-picked);
			background: var(--zing-picked-soft);
			color: var(--zing-picked);
		}
		.chip.picked::after, .decision.picked::after {
			content: " \2713";
		}

		/* The item rows an item-kind question renders (design section 6.5,
		   9.2, Task 11b): the path, the marker pill, the builder reason, and
		   the change, on one line, with the decision buttons pushed to the
		   far end. */
		.item-row {
			display: flex;
			align-items: baseline;
			gap: 0.5rem;
			padding: 0.375rem 0;
			border-bottom: 1px solid var(--zing-border);
		}
		.item-row:last-child { border-bottom: none; }
		.item-ref { font-family: monospace; }
		.item-reason, .item-text { color: var(--zing-text-dim); }
		.item-change { flex: 1; }
		.item-decisions { display: flex; gap: 0.375rem; margin-left: auto; }

		/* The option chip and the item-decision button (design section 6.6,
		   Task 11b): the same base look, so a decision button reads as the
		   same kind of control as a chip rather than a bare browser button;
		   .chip.picked/.decision.picked above still layers the picked state
		   on top of this. */
		.chip, .decision {
			border: 1px solid var(--zing-border);
			border-radius: 999px;
			background: var(--zing-surface);
			color: var(--zing-text);
			padding: 0.25rem 0.75rem;
			font-size: 0.8rem;
			cursor: pointer;
		}
		.chip:hover, .decision:hover { border-color: var(--zing-accent); }

		/* The free reply input (design section 6.6, Task 11b): dark-themed
		   to match the rest of the console instead of the browser default. */
		.reply-input {
			width: 100%;
			background: var(--zing-surface);
			color: var(--zing-text);
			border: 1px solid var(--zing-border);
			border-radius: 0.375rem;
			padding: 0.375rem 0.5rem;
			font: inherit;
		}

		/* The draft banner and per-reply hint (bug fix): sending is
		   keyboard-only by design (Q31), and nothing on screen said so,
		   which left the owner thinking a saved draft had been lost.
		   draftBanner (thread.templ) shows once, only while the ticket
		   carries a draft; reply-hint shows under every reply box, since
		   it explains what that box does rather than reporting state. */
		.draft-banner {
			color: var(--zing-text-dim);
			font-size: 0.85rem;
			margin: 0.5rem 0;
		}
		/* .wait-progress (bug fix, thread.templ's waitProgressBanner): the
		   current round's answered-vs-total count, e.g. "Answered 1 of 2.
		   Zing resumes the agent when every question is answered." --
		   correct design (every question of a round must be answered before
		   Zing resumes), but previously unexplained. */
		.wait-progress {
			color: var(--zing-text-dim);
			font-size: 0.85rem;
			margin: 0 0 0.75rem;
		}
		.reply-hint {
			color: var(--zing-text-dim);
			font-size: 0.75rem;
			margin: 0.25rem 0 0;
		}
		/* .draft-saved (bug fix 11, console.js's showDraftSaved): "Saved." next
		   to a reply box right after Enter actually saves its draft, since the
		   box itself no longer clears on Enter and needed its own on-screen
		   confirmation. Empty (the common case) renders nothing, matching
		   #alerts:empty above. */
		.draft-saved:empty { display: none; }
		.draft-saved {
			color: var(--zing-accent);
			font-size: 0.75rem;
			margin: 0.25rem 0 0;
		}
		/* .draft-conflict (bug fix, console.js's showDraftConflict): a
		   closed-question 409 beside the reply box that triggered it, e.g.
		   "This question is already answered." Empty (the common case)
		   renders nothing, matching #alerts:empty above. */
		.draft-conflict:empty { display: none; }
		.draft-conflict {
			color: var(--zing-danger);
			font-size: 0.75rem;
			margin: 0.25rem 0 0;
		}
		/* .q-answered (bug fix, thread.templ's answeredLocked): a closed,
		   answered question's locked note, shown where its now-hidden
		   controls were, naming what was actually sent. */
		.q-answered {
			color: var(--zing-text-dim);
			font-size: 0.85rem;
			margin: 0.5rem 0 0;
		}
		/* .q-revisable (D30, thread.templ's reviseNote): an already-answered
		   question whose controls are still live, since the ticket still
		   waits on this round -- distinct from .q-answered's locked note. */
		.q-revisable {
			color: var(--zing-accent);
			font-size: 0.8rem;
			margin: 0 0 0.5rem;
		}
		/* .q-turns and .q-turn (bug fix 10, extended by D31-5, thread.templ's
		   turnsList): a question's own conversation, shown under its options
		   instead of as a detached "reply you" card at the bottom of the
		   thread. .turn-author labels who wrote it; a turn with none (a bare
		   system note such as "Resolved.") renders unlabeled. .pill-queued
		   marks an owner turn no run has taken delivery of yet (design
		   section 22.7). */
		.q-turn {
			color: var(--zing-text-dim);
			font-size: 0.85rem;
			margin: 0.35rem 0 0;
		}
		.turn-author {
			color: var(--zing-text);
			font-weight: 600;
			margin-right: 0.25rem;
		}
		.pill-queued {
			margin-left: 0.5rem;
			background: var(--zing-border);
		}
		/* .q-settled (D31, design section 22.7 item 6, thread.templ's
		   settledBlock): a planning question's own closing line once the
		   agent has settled it, in place of .q-answered for every other
		   kind. */
		.q-settled {
			color: var(--zing-text-dim);
			font-size: 0.85rem;
			margin: 0.5rem 0 0;
		}
		/* .agent-status (design section 22.7, views.go's buildAgentStatus): the
		   Thread view's own banner for a ticket with at least one planning
		   question, in place of .wait-progress. */
		.agent-status {
			color: var(--zing-text-dim);
			font-size: 0.85rem;
			margin: 0 0 0.75rem;
		}
		/* .chip.locked and .decision.locked (bug fix: "options vanish once
		   locked", design section 22.7 item 4): a settled or answered
		   question's own numbered list, disabled rather than removed, so
		   what was picked stays visible. */
		.chip.locked, .decision.locked {
			opacity: 0.7;
			cursor: default;
		}

		/* #send-result (bug fix, console.js's showSendResult): a client-owned
		   banner reporting POST /send's own result line ("Sent N answer(s)."
		   or "Nothing to send."), appended outside #main/#rail so the patch
		   POST /send's own bus.Publish triggers right after cannot morph it
		   back to nothing before a reader sees it. Empty (before the first
		   send) renders nothing, matching #alerts:empty above. */
		#send-result:empty { display: none; }
		#send-result {
			position: fixed;
			left: 50%;
			bottom: 1.5rem;
			transform: translateX(-50%);
			z-index: 900;
			padding: 0.5rem 1rem;
			border-radius: 0.375rem;
			background: var(--zing-surface);
			border: 1px solid var(--zing-border);
			color: var(--zing-text);
			font-size: 0.85rem;
		}

		/* #stream-status (the reconnect plan, console.js's renderStreamStatus):
		   a client-owned node reporting /stream's own connection state,
		   outside #nav/#main/#rail for the same reason #send-result above is
		   -- a region patch cannot morph it away before a reader sees it.
		   Empty while the stream is live, matching #alerts:empty above;
		   staleMarkerText (keyboard.mjs) fills it in once the page goes
		   stale. body.stream-stale (also set by renderStreamStatus) dims
		   nav.templ's "All clear." so a reader does not mistake a stale,
		   unrefreshed view for an up-to-date one. */
		#stream-status:empty { display: none; }
		#stream-status {
			position: fixed;
			top: 0.75rem;
			right: 1rem;
			z-index: 900;
			padding: 0.375rem 0.75rem;
			border-radius: 0.375rem;
			background: var(--zing-surface);
			border: 1px solid var(--zing-warn);
			color: var(--zing-warn);
			font-size: 0.8rem;
		}
		body.stream-stale .nav-threads .empty { opacity: 0.35; }

		/* The rail (design section 6.11): Phase, Artifacts, Run, Log, and the
		   side box, in the mock's order. */
		#rail section { margin-bottom: 1.25rem; }
		#rail h3 {
			font-size: 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.04em;
			color: var(--zing-text-dim);
			margin-bottom: 0.5rem;
		}
		.phase-dots { display: flex; flex-wrap: wrap; gap: 0.375rem; }
		.phase-dot {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			font-size: 0.75rem;
			padding: 0.25rem 0.5rem;
			border-radius: 999px;
			border: 1px solid var(--zing-border);
			color: var(--zing-text-dim);
		}
		.phase-now { border-color: var(--zing-accent); color: var(--zing-text); }
		.phase-done { color: var(--zing-text); }
		.artifact-slot {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			gap: 0.5rem;
			padding: 0.25rem 0;
			border-bottom: 1px solid var(--zing-border);
		}
		.artifact-payload {
			white-space: pre-wrap;
			word-break: break-word;
			font-size: 0.75rem;
			max-height: 12rem;
			overflow-y: auto;
		}
		.run-fields { display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 0.5rem; margin: 0; }
		.run-fields dt { color: var(--zing-text-dim); font-size: 0.8rem; }
		.run-fields dd { margin: 0; }
		.run-list { list-style: none; margin: 0; padding: 0; }
		.run-row {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0.375rem;
			padding: 0.375rem 0;
			border-bottom: 1px solid var(--zing-border);
			font-size: 0.8rem;
		}
		.run-id { color: var(--zing-text-dim); }
		.run-transcript { color: var(--zing-text-dim); word-break: break-all; }
		.side-box textarea {
			width: 100%;
			background: var(--zing-surface);
			color: var(--zing-text);
			border: 1px solid var(--zing-border);
			border-radius: 0.375rem;
			resize: vertical;
		}
		.side-reply:not(:empty) {
			margin-top: 0.5rem;
			padding: 0.5rem;
			background: var(--zing-surface);
			border: 1px solid var(--zing-border);
			border-radius: 0.375rem;
			font-size: 0.85rem;
		}

		/* .sandbox-run-box (thread.templ's sandboxRunBox): the owner's "run a
		   command in this ticket's sandbox" form, styled like .pickup-box
		   and .side-box above. */
		.sandbox-run-box {
			border: 1px solid var(--zing-border);
			border-radius: 0.5rem;
			padding: 0.75rem 1rem;
			margin-bottom: 0.75rem;
			background: var(--zing-surface);
		}
		.sandbox-run-box label { display: block; margin-bottom: 0.375rem; }
		.sandbox-run-cmd {
			width: 100%;
			background: var(--zing-bg);
			color: var(--zing-text);
			border: 1px solid var(--zing-border);
			border-radius: 0.375rem;
			padding: 0.375rem 0.5rem;
			font: inherit;
			margin-bottom: 0.5rem;
		}

		/* #sandbox-run-result (shell.templ, console.js's runInSandbox): a
		   client-owned dialog outside #main, so a /stream patch while the
		   command runs never clobbers it. */
		.sandbox-run-result {
			background: var(--zing-surface);
			color: var(--zing-text);
			border: 1px solid var(--zing-border);
			border-radius: 0.5rem;
			padding: 1rem;
			max-width: 40rem;
		}
		.sandbox-run-output {
			max-height: 60vh;
			overflow: auto;
			white-space: pre-wrap;
			background: var(--zing-bg);
			border: 1px solid var(--zing-border);
			border-radius: 0.375rem;
			padding: 0.5rem;
		}
	</style>
}
