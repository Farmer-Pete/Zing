package templates

import (
	"regexp"
	"slices"
	"strconv"

	"zing/internal/response"
)

// hostCheckWSRun matches a tab, or a run of more than 4 consecutive
// spaces: either can push the rest of a long host check off screen behind
// #main pre's own horizontal scrollbar, with nothing at the gate to show
// it is there (r2f2), so the gate marks a run like that visibly instead of
// letting it blend into ordinary spacing.
var hostCheckWSRun = regexp.MustCompile(`\t+| {5,}`)

// hostCheckSegment is one piece of a host check's display text: ordinary
// text, rendered plain, or a run hostCheckWSRun matched, rendered inside
// .host-check-ws so no part of the command can hide off screen.
type hostCheckSegment struct {
	Text   string
	Marked bool
}

// hostCheckSegments splits check into alternating ordinary and marked
// segments, in order, on every match of hostCheckWSRun.
func hostCheckSegments(check string) []hostCheckSegment {
	var segs []hostCheckSegment
	idx := 0
	for _, loc := range hostCheckWSRun.FindAllStringIndex(check, -1) {
		if loc[0] > idx {
			segs = append(segs, hostCheckSegment{Text: check[idx:loc[0]]})
		}
		segs = append(segs, hostCheckSegment{Text: check[loc[0]:loc[1]], Marked: true})
		idx = loc[1]
	}
	if idx < len(check) {
		segs = append(segs, hostCheckSegment{Text: check[idx:]})
	}
	return segs
}

// scenariosSection renders the gate's scenario cohort table (design section
// 7, D8, Task 11): id, kind, given, when, then, check, one row per scenario
// in the order internal/console/views.go's loadScenarios returns them (the
// store's own insertion order, ScenariosForRun/AllScenarios's own "ORDER BY
// artifacts.id"). Every field renders raw -- a human reads a scenario, not
// another agent -- escaped by templ as usual. Renders nothing when
// scenarios is empty, matching findingsSection's own "no empty table" rule:
// a ticket with no cohort, or a cohort with none yet, shows no table at all.
// The last cell holds a sealed scenario's own owner-edit box (#41,
// ownerEditScenarioForm), empty for an unsealed scenario. When any row is
// kind host, the section first renders the "Runs on your machine at
// judging" list of host ids and verbatim checks, in the slice's own order:
// approving the gate approves those commands (host scenario kind, #137) --
// but only while atGate is true (#75): after the seal, approving the gate
// is already behind the ticket, so the post-gate sealed section renders
// that list only within the gate's own copy, never within its own.
templ scenariosSection(scenarios []ScenarioRow, atGate bool) {
	if len(scenarios) > 0 {
		if atGate && slices.ContainsFunc(scenarios, func(s ScenarioRow) bool { return s.Kind == "host" }) {
			<section class="host-checks">
				<h3>Runs on your machine at judging</h3>
				<p>Approving this gate approves these commands. Zing runs each one on this machine, outside any sandbox, before the judge runs.</p>
				<table class="host-checks">
					<tbody>
						for _, s := range scenarios {
							if s.Kind == "host" {
								<tr>
									<td class="host-check-id">{ s.ID }</td>
									<td><pre><code class="host-check">for _, seg := range hostCheckSegments(s.Check) {
										if seg.Marked {
											<span class="host-check-ws">{ seg.Text }</span>
										} else {
											{ seg.Text }
										}
									}</code></pre></td>
								</tr>
							}
						}
					</tbody>
				</table>
			</section>
		}
		<table class="scenarios">
			<thead>
				<tr>
					<th>ID</th>
					<th>Kind</th>
					<th>Given</th>
					<th>When</th>
					<th>Then</th>
					<th>Check</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, s := range scenarios {
					<tr>
						<td>{ s.ID }</td>
						<td>{ s.Kind }</td>
						<td>{ s.Given }</td>
						<td>{ s.When }</td>
						<td>{ s.Then }</td>
						<td>{ s.Check }</td>
						<td>
							if s.Sealed {
								@ownerEditScenarioForm(s)
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// ownerEditScenarioForm is the scenarios table's own owner-edit box (#41):
// ownerEditScenarioBox with no pending answer, summary "Edit".
templ ownerEditScenarioForm(s ScenarioRow) {
	@ownerEditScenarioBox(s, 0, "Edit")
}

// ownerEditScenarioBox is one sealed scenario's owner-edit box (#41, #57): a
// <details class="owner-edit"> the owner opens to rewrite given, when,
// then, check, or kind, posted by console.js's ownerEditSubmit to POST
// /tickets/{id}/edit. data-preserve-attr="open" keeps it open across a
// /stream patch while the owner is editing, matching questionGroup's own
// use of the attribute. Each textarea's content opens with a "\n" (bug
// fix): the HTML parser drops exactly one leading newline right after a
// textarea's opening tag, so without it a stored value that itself starts
// with a newline would render one character short; the prefix makes the
// parser's drop a no-op either way. The kind select's data-initial lets
// console.js's ownerEditSubmit detect a change the same way it already does
// for every other field's defaultValue (a select's own value has no such
// browser-native default). summary is the box's own <summary> text: plain
// "Edit" from the scenarios table, "Edit it" from an amended escalation's
// card (questionGroup). answerQuestionID, when non-zero, is the open
// amended-check escalation this box's Save should also answer option b on,
// in the same store transaction (#57 Q3): console.js reads it off
// data-answer-question and sends every field, changed or not, plus
// answer_question.
templ ownerEditScenarioBox(s ScenarioRow, answerQuestionID int64, summary string) {
	<details
		class="owner-edit"
		data-preserve-attr="open"
		data-ticket={ strconv.FormatInt(s.TicketID, 10) }
		data-target="scenario"
		data-ref={ s.ID }
		if answerQuestionID != 0 {
			data-answer-question={ strconv.FormatInt(answerQuestionID, 10) }
		}
	>
		<summary>{ summary }</summary>
		<label>Given</label>
		<textarea data-field="given">{ "\n" + s.Given }</textarea>
		<label>When</label>
		<textarea data-field="when">{ "\n" + s.When }</textarea>
		<label>Then</label>
		<textarea data-field="then">{ "\n" + s.Then }</textarea>
		<label>Check</label>
		<input type="text" data-field="check" value={ s.Check }/>
		<label>Kind</label>
		<select data-field="kind" data-initial={ s.Kind }>
			for _, k := range response.ScenarioKind("").Values() {
				<option value={ k } selected?={ k == s.Kind }>{ k }</option>
			}
		</select>
		<button type="button" class="owner-edit-save">Save</button>
		<span class="owner-edit-error"></span>
	</details>
}
