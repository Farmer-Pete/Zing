{
  "$schema": "https://zing.example/schemas/graph.json",
  "title": "Activity feed (mixed-axis worked example)",
  "kinds": {
    "data": {"label": "data flow"},
    "schema": {"label": "schema dependency"},
    "control": {"label": "control"}
  },
  "steps": [
    {
      "step": 1,
      "id": "ingest",
      "title": "Ingest events",
      "concern": "Parse and validate incoming activity events.",
      "nodes": [
        {"id": "parse-event", "shape": "rect", "side": "proposed", "label": "parse_event(raw)"},
        {"id": "validate", "shape": "diamond", "side": "shared", "label": "schema valid?"},
        {
          "id": "event-payload",
          "shape": "struct",
          "kind": "struct",
          "side": "shared",
          "label": "EventPayload",
          "fields": [
            {"name": "actor_id", "side": "diverged", "today": "int", "proposed": "UUID"},
            {"name": "source", "type": "str", "side": "proposed"},
            {"name": "timestamp", "type": "datetime", "side": "shared"}
          ]
        }
      ],
      "edges": [
        {"from": "parse-event", "to": "validate"},
        {"from": "validate", "to": "event-payload"}
      ]
    },
    {
      "step": 2,
      "id": "feed_store",
      "title": "Feed store",
      "concern": "Persist activities and index for per-user lookup.",
      "nodes": [
        {
          "id": "activity",
          "shape": "struct",
          "kind": "struct",
          "side": "shared",
          "label": "Activity",
          "fields": [
            {"name": "id", "type": "UUID", "side": "shared", "note": "PK"},
            {"name": "kind", "side": "diverged", "today": "TEXT", "proposed": "ActivityKind"},
            {"name": "payload", "type": "JSONB", "side": "proposed"},
            {"name": "legacy_blob", "type": "bytes", "side": "existing"}
          ]
        },
        {
          "id": "activity-kind",
          "shape": "struct",
          "kind": "union",
          "side": "proposed",
          "label": "ActivityKind",
          "fields": [
            {"name": "click", "side": "proposed"},
            {"name": "scroll", "side": "proposed"},
            {"name": "submit", "side": "proposed"}
          ]
        },
        {
          "id": "activity-cache",
          "shape": "struct",
          "kind": "collections",
          "side": "proposed",
          "label": "ActivityCache",
          "fields": [
            {"name": "recent", "type": "Deque[Activity]", "side": "proposed"},
            {"name": "pending_writes", "type": "List[Activity]", "side": "proposed"}
          ]
        }
      ],
      "edges": [
        {"from": "activity", "to": "activity-kind"},
        {"from": "activity-cache", "to": "activity"}
      ]
    }
  ],
  "cross_flows": [
    {
      "from_step": 1, "from_node": "event-payload",
      "to_step": 2, "to_node": "activity",
      "label": "EventPayload → Activity",
      "kind": "data"
    },
    {
      "from_step": 2, "from_node": "activity-kind",
      "to_step": 1, "to_node": "parse-event",
      "label": "variants known at parse",
      "kind": "schema"
    }
  ]
}
