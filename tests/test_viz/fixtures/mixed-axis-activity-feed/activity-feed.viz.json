{
  "$schema": "https://zing.example/schemas/graph.json",
  "title": "Activity feed (mixed-axis worked example)",
  "kinds": {
    "data": {
      "label": "data flow"
    },
    "schema": {
      "label": "schema dependency"
    },
    "control": {
      "label": "control"
    }
  },
  "steps": [
    {
      "step": 1,
      "id": "ingest",
      "title": "Ingest events",
      "concern": "Parse and validate incoming activity events.",
      "nodes": [
        {
          "id": "parse-event",
          "shape": "rect",
          "side": "added",
          "label": "parse_event(raw)"
        },
        {
          "id": "validate",
          "shape": "diamond",
          "side": "unchanged",
          "label": "schema valid?"
        },
        {
          "id": "event-payload",
          "shape": "struct",
          "kind": "struct",
          "side": "unchanged",
          "label": "EventPayload",
          "fields": [
            {
              "name": "actor_id",
              "side": "diverged",
              "today": "int",
              "proposed": "UUID"
            },
            {
              "name": "source",
              "type": "str",
              "side": "added"
            },
            {
              "name": "timestamp",
              "type": "datetime",
              "side": "unchanged"
            }
          ]
        }
      ],
      "edges": [
        {
          "from": "parse-event",
          "to": "validate"
        },
        {
          "from": "validate",
          "to": "event-payload"
        }
      ],
      "side": "diverged"
    },
    {
      "step": 2,
      "id": "feed_store",
      "title": "Feed store",
      "concern": "Persist activities and index for per-user lookup.",
      "nodes": [
        {
          "id": "activity",
          "shape": "struct",
          "kind": "struct",
          "side": "unchanged",
          "label": "Activity",
          "fields": [
            {
              "name": "id",
              "type": "UUID",
              "side": "unchanged",
              "note": "PK"
            },
            {
              "name": "kind",
              "side": "diverged",
              "today": "TEXT",
              "proposed": "ActivityKind"
            },
            {
              "name": "payload",
              "type": "JSONB",
              "side": "added"
            },
            {
              "name": "legacy_blob",
              "type": "bytes",
              "side": "removed"
            }
          ]
        },
        {
          "id": "activity-kind",
          "shape": "struct",
          "kind": "union",
          "side": "added",
          "label": "ActivityKind",
          "fields": [
            {
              "name": "click",
              "side": "added"
            },
            {
              "name": "scroll",
              "side": "added"
            },
            {
              "name": "submit",
              "side": "added"
            }
          ]
        },
        {
          "id": "activity-cache",
          "shape": "struct",
          "kind": "collections",
          "side": "added",
          "label": "ActivityCache",
          "fields": [
            {
              "name": "recent",
              "type": "Deque[Activity]",
              "side": "added"
            },
            {
              "name": "pending_writes",
              "type": "List[Activity]",
              "side": "added"
            }
          ]
        }
      ],
      "edges": [
        {
          "from": "activity",
          "to": "activity-kind"
        },
        {
          "from": "activity-cache",
          "to": "activity"
        }
      ],
      "side": "added"
    }
  ],
  "cross_flows": [
    {
      "from_step": 1,
      "from_node": "event-payload",
      "to_step": 2,
      "to_node": "activity",
      "label": "EventPayload → Activity",
      "kind": "data"
    },
    {
      "from_step": 2,
      "from_node": "activity-kind",
      "to_step": 1,
      "to_node": "parse-event",
      "label": "variants known at parse",
      "kind": "schema"
    }
  ]
}
