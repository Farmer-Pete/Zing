(version 1)
(allow default)

; PKG9-PLAN.md section 7.3. This is build.sb's own rules plus the
; judge-only block below (SCENARIOS_FILE, CODEX_HOME, and the ~/.claude /
; ~/.codex denies) and a replaced write block. M2 task 1's own
; judge_probe_darwin_test.go proves this file on the host (D19, D20); M2
; task 2 wires LoadProfile, Params, and Prefix to pass SCENARIOS_FILE and
; CODEX_HOME for real (internal/sandbox) and loads it from serve
; (cmd/zing/serve.go).

; Reads in home are denied by default, then allowed by name. No profile
; reads the keychain (PKG9-PLAN.md D26, N2): the Claude CLI logs in with
; CLAUDE_CODE_OAUTH_TOKEN instead, so ~/Library/Keychains is never allowed.
(deny file-read-data (subpath (param "HOME")))
(allow file-read-data
  (subpath (param "WORKTREE"))
  (subpath (param "REPO_GIT"))
  (subpath (string-append (param "HOME") "/.claude"))
  (literal (string-append (param "HOME") "/.claude.json"))
  (subpath (param "CACHE_ROOT")))
; No other session's transcript, the planning session's above all (N6): the
; planning transcript holds the sealed scenarios, so the judge must not
; read any transcript folder but its own (PKG9-PLAN.md section 7.3, a
; Package 8 holdout fix). The judge-only block below denies file-read* on
; the whole of ~/.claude anyway (N6), which wins over the file-read-data
; allow above because it comes later in this file.
(deny file-read-data (subpath (string-append (param "HOME") "/.claude/projects")))
(allow file-read-data (subpath (param "TRANSCRIPTS")))
;;READ_PATHS;;

; The console has no login. The judge must not read it or answer through
; it.
;;CONSOLE_DENY;;

; No system service may act for the judge outside the sandbox. No profile
; allows com.apple.SecurityServer any more (D26, N2): that Mach service is
; how a process reaches the keychain, and the Claude CLI's login no longer
; lives there. com.apple.trustd.agent stays only if M1 task 7's host probe
; (TestProbeTLSWithoutSecurityServer) shows TLS verification fails without
; it once SecurityServer is gone; the probe's own result belongs in this
; comment once it has run.
(deny appleevent-send)
(deny mach-lookup)
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.membership")
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.trustd.agent"))

; No connection to the owner's ssh-agent: an agent process must never be
; able to sign for the owner's SSH key (D26, N2). This is the first of
; 7.3's two candidate rule forms; M1 task 7's host probe
; (TestProbeSSHAgentDenied) decides whether it actually blocks `ssh-add -l`
; against the real agent socket, or whether the second form
; (network-outbound regex, no "remote unix-socket" wrapper) is needed
; instead.
(deny network-outbound (remote unix-socket (path-regex #"^/private/tmp/com\.apple\.launchd\.[^/]+/Listeners$")))

; No git credential helper may run: it would hand out the owner's GitHub
; credentials (N2). Git execs helpers as git-credential-<name>. Defense in
; depth, not a guarantee (D26): a "!" shell helper is not caught by this.
(deny process-exec (regex #"/git-credential-[^/]*$"))

; The Zing data directory holds the sealed scenarios.
(deny file-read* file-write* (subpath (param "DATA_DIR")))
(allow file-read* process-exec (literal (param "ZING_BIN")))

; The judge reads the sealed scenarios from one file Zing wrote for this
; run (D19). Nothing else under DATA_DIR, the database included.
(allow file-read* (literal (param "SCENARIOS_FILE")))

; Codex keeps its login and sessions in the dedicated judge Codex home
; (judge_codex_home, D27), not in the owner's ~/.codex.
(allow file-read* (subpath (param "CODEX_HOME")))

; The judge reads no agent transcript and no Codex state of the owner's
; (N6). These come after the home read allow above, so they win over its
; ~/.claude allow.
(deny file-read* (subpath (string-append (param "HOME") "/.claude")))
(deny file-read* (literal (string-append (param "HOME") "/.claude.json")))
(deny file-read* (subpath (string-append (param "HOME") "/.codex")))

; Writes are denied everywhere, then allowed by name. This replaces
; build.sb's own write block: the judge writes no Claude transcript, so
; there is no TRANSCRIPTS allow here, and the CODEX_HOME write allow sits
; after the global write deny, because the later rule wins.
(deny file-write* (subpath "/"))
(allow file-write*
  (subpath (param "WORKTREE"))
  (subpath (param "MDS_CACHE"))
  (subpath (param "RUN_DIR"))
  (subpath (param "CACHE_SHARED"))
  (subpath (param "CODEX_HOME"))
  (subpath "/dev"))
(deny file-write* (literal (string-append (param "WORKTREE") "/.git")))
