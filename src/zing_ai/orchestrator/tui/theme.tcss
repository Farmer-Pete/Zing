/* Zing Design System - Textual CSS
 *
 * Color tokens (defined via Theme class, referenced here):
 *   $status-pending:  #6B7280
 *   $status-running:  #4F8CFF
 *   $status-success:  #2ECC71
 *   $status-warning:  #F5B041
 *   $status-failed:   #E74C3C
 *   $border-subtle:   #252B36
 *   $text-muted:      #6B7280
 *
 * Spacing: 8px base unit
 * Border radius: 6px (not natively supported in Textual, approximated with box styling)
 * Card padding: 16px (2 units)
 */

/* ── Status Dots ─────────────────────────────────────────── */

.status-dot {
    width: 2;
    height: 1;
    content-align: center middle;
}

.status-dot--pending {
    color: #6B7280;
}

.status-dot--running {
    color: #4F8CFF;
}

.status-dot--success {
    color: #2ECC71;
}

.status-dot--warning {
    color: #F5B041;
}

.status-dot--failed {
    color: #E74C3C;
}

/* ── Recommended Pill ────────────────────────────────────── */

.recommended-pill {
    background: #9B59B6;
    color: #FFFFFF;
    padding: 0 1;
    height: 1;
    width: auto;
    text-style: bold;
}

/* ── Choice Cards ────────────────────────────────────────── */

.choice-card {
    padding: 1 2;
    margin: 1 0;
    border: solid #252B36;
    background: $surface;
    height: auto;
}

.choice-card:hover {
    border: solid #4F8CFF;
}

.choice-card--selected {
    border: solid #4F8CFF;
    background: $panel;
}

/* ── Step Tracker ────────────────────────────────────────── */

.step-tracker {
    height: auto;
    padding: 1 2;
    border: solid #252B36;
    background: $surface;
}

.step-tracker__item {
    height: 1;
    padding: 0 1;
}

.step-tracker__item--active {
    text-style: bold;
    color: #4F8CFF;
}

.step-tracker__item--complete {
    color: #2ECC71;
}

.step-tracker__item--failed {
    color: #E74C3C;
}

.step-tracker__item--pending {
    color: #6B7280;
}

/* ── Log Panels ──────────────────────────────────────────── */

.log-panel {
    padding: 1 2;
    border: solid #252B36;
    background: $surface;
    height: 1fr;
    overflow-y: auto;
}

.log-panel__title {
    text-style: bold;
    padding: 0 0 1 0;
    color: #9DA7B3;
}

/* ── Action Buttons ──────────────────────────────────────── */

.action-button {
    margin: 1 1;
    min-width: 16;
}

.action-button--primary {
    background: #4F8CFF;
    color: #FFFFFF;
}

.action-button--danger {
    background: #E74C3C;
    color: #FFFFFF;
}

.action-button--secondary {
    background: #252B36;
    color: #9DA7B3;
}

/* ── General Layout ──────────────────────────────────────── */

Screen {
    background: $background;
}

.container {
    padding: 1 2;
}

.card {
    padding: 1 2;
    margin: 1 0;
    border: solid #252B36;
    background: $surface;
}

.text-muted {
    color: #6B7280;
}

.gap {
    height: 1;
}
